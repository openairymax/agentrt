    mkdir -p "$rel"
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] && cp -r "$AIRY_HOME/$d" "$rel/" 2>/dev/null || true
    done
    if [ ! -e "$rel/bin" ] || [ ! -e "$rel/lib" ]; then
        log error "布局迁移失败（复制不完整），保持原布局继续"
        rm -rf "$rel"
        return 1
    fi
    rel_env_write "$rel" "v${id}" "$(sed -n 's/^AIRY_ARTIFACT_SHA256=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    : > "$rel/.complete"
    if ! rel_commit "$rel"; then
        log error "布局迁移失败（current 切换被拒），保持原布局继续"
        rm -rf "$rel"
        return 1
    fi
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] || continue
        if ! mv "$AIRY_HOME/$d" "$AIRY_HOME/$d.mig.bak" 2>/dev/null; then
            log error "布局迁移失败（$d 重命名被拒），保持原布局继续"
            rm -rf "$rel"
            return 1
        fi
        if ! ln -s "current/$d" "$AIRY_HOME/$d" 2>/dev/null; then
            mv "$AIRY_HOME/$d.mig.bak" "$AIRY_HOME/$d" 2>/dev/null || true
            log error "布局迁移失败（$d 符号链接建立被拒），保持原布局继续"
            rm -rf "$rel"
            return 1
        fi
        rm -rf "$AIRY_HOME/$d.mig.bak"
    done
    rm -rf "$AIRY_HOME/.rollback" 2>/dev/null || true
    log ok "安装布局已迁移至版本化目录（releases/$(basename "$rel")）"
    return 0
}

upd_recover() {
    local it="$AIRY_HOME/run/update.intent" target rel d
    [ -f "$it" ] || return 0
    target="$(sed -n 's/^target=//p' "$it" 2>/dev/null | head -1)"
    if [ -n "$target" ] && [ -d "$AIRY_HOME/releases/$target" ]; then
        rel="$AIRY_HOME/releases/$target"
        if [ -f "$rel/.complete" ]; then
            if rel_commit "$rel"; then
                upd_env_sync "$rel"
                log ok "已恢复上次中断的更新（当前版本: ${target}）"
            else
                log error "在途更新恢复失败（current 切换被拒），intent 已保留待重试"
                return 1
            fi
        else
            rm -rf "$rel"
            log warn "上次更新在提交前中断，已清理未完成版本（当前版本未受影响）"
        fi
    else
        log warn "上次更新意图记录不完整，已忽略"
    fi
    upd_intent_clear
    [ -d "$AIRY_HOME/releases" ] && \
        find "$AIRY_HOME/releases" -maxdepth 1 -name '.staging.*' -exec rm -rf {} + 2>/dev/null || true
    for d in bin lib include share; do
        if [ -d "$AIRY_HOME/$d.mig.bak" ]; then
            rm -rf "$AIRY_HOME/$d"
            mv "$AIRY_HOME/$d.mig.bak" "$AIRY_HOME/$d" 2>/dev/null || true
            log warn "已恢复迁移中断目录: $d"
        fi
    done
    return 0
}

upd_boot_recover() {
    [ -f "$AIRY_HOME/run/update.intent" ] || return 0
    upd_lock_acq quiet || return 0
    upd_recover || log warn "在途更新恢复未完成（保留 intent 待下次重试）"
    upd_lock_rel
}

apply_package() {
    local tarball="$1" expect_sha="$2" arch="$(detect_arch)"
    find "$AIRY_HOME/releases" -maxdepth 1 -name '.staging.*' -mtime +0 -exec rm -rf {} + 2>/dev/null || true
    migrate_layout || return 1
    upd_lock_acq || return 1
    upd_recover || { upd_lock_rel; return 1; }
    local TMPD="$AIRY_HOME/releases/.staging.$$"
    rm -rf "$TMPD"
    if ! mkdir -p "$AIRY_HOME/releases" "$TMPD" 2>/dev/null; then
        log error "releases/ 目录创建失败（磁盘/权限），当前版本未受影响"
        upd_lock_rel; return 1
    fi
    if [ -z "$expect_sha" ]; then
        log error "缺少 sha256 期望值，拒绝安装（防供应链绕过）"; rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    if [ "$(sha256_file "$tarball")" != "$expect_sha" ]; then
        log error "sha256 校验失败，拒绝安装"; rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    log ok "sha256 校验通过"
    _am_bad=""
    if ! _am_bad="$(arch_markers_ok "$tarball" "$arch")"; then
        log error "制品架构与当前主机（${arch}）不匹配（包内标记 $(echo $_am_bad | tr ' ' '/')），拒绝更新"
        log error "  期望标记之一: $(plat_markers "$arch")"
        log error "  制品: $tarball"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    log info "架构校验通过（${arch}）"
    if ! tar -xzf "$tarball" -C "$TMPD"; then
        log error "解压失败（制品损坏或磁盘不足），当前版本未受影响"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    local extracted="$(find "$TMPD" -maxdepth 1 -type d -name 'agentrt-*' | head -1)"
    [ -n "$extracted" ] || { log error "包结构异常（缺 agentrt-* 顶层目录）"; rm -rf "$TMPD"; upd_lock_rel; return 1; }
    local new_ver="$(basename "$extracted" | sed -e 's/^agentrt-//' -e 's/^v//')"
    local new_id="${new_ver}-$(printf '%s' "$expect_sha" | cut -c1-8)"
    local rel="$AIRY_HOME/releases/$new_id"
    [ -e "$rel" ] && rel="$AIRY_HOME/releases/${new_id}-$(date +%H%M%S)"
    if ! mv "$extracted" "$rel"; then
        log error "版本目录就位失败（rename 被拒，检查磁盘/权限），当前版本未受影响"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    rm -rf "$TMPD"
    upd_intent_set "$new_id"
    [ -d "$rel/bin" ] || mkdir -p "$rel/bin"
    if [ -d "$AIRY_HOME/bin" ]; then
        local _ef
        for _ef in airymaxrt airymaxrt-full agentrt-env.sh; do
            [ -e "$rel/bin/$_ef" ] && continue
            [ -f "$AIRY_HOME/bin/$_ef" ] && cp -f "$AIRY_HOME/bin/$_ef" "$rel/bin/$_ef" 2>/dev/null || true
        done
    fi
    if [ ! -x "$rel/bin/airy_cli" ] || [ ! -x "$rel/bin/agentrt-bootstrap.sh" ]; then
        log error "制品自检失败（bin/ 关键组件缺失），已中止更新，当前版本未受影响"
        rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
    fi
    local _py
    for _py in airymax_agents airymax_agents_rs orchestration agentrt; do
        if [ ! -d "$rel/lib/$_py" ]; then
            log error "制品自检失败（lib/${_py} python 运行时缺失），已中止更新，当前版本未受影响"
            rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
        fi
    done
    rel_env_write "$rel" "v${new_ver}" "$expect_sha"
    : > "$rel/.complete"
    local prev_rel=""
    prev_rel="$(readlink "$AIRY_HOME/current" 2>/dev/null || true)"
    if ! rel_commit "$rel"; then
        log error "更新提交失败（current 切换被拒），当前版本未受影响"
        rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
    fi
    upd_intent_clear
    log ok "新版本已提交: $new_id"
    if [ -d "$rel/config" ]; then
        mkdir -p "$AIRY_HOME/config"
        local f b
        for f in "$rel"/config/*; do
            [ -f "$f" ] || continue
            b="$(basename "$f")"
            case "$b" in
                secrets.env) continue ;;
                agentrt.yaml|model.yaml|permission_rules.yaml)
                    cp -f "$f" "$AIRY_HOME/config/$b" 2>/dev/null || true
                    log info "config 模板已随更新刷新: $b" ;;
                *) [ -f "$AIRY_HOME/config/$b" ] || cp -f "$f" "$AIRY_HOME/config/" 2>/dev/null || true ;;
            esac
        done
    fi
    if [ -f "$AIRY_HOME/config/permission_rules.yaml" ]; then
        mkdir -p "$AIRY_HOME/config/cupolas"
        cp -f "$AIRY_HOME/config/permission_rules.yaml" "$AIRY_HOME/config/cupolas/permission_rules.yaml" 2>/dev/null || true
        chmod 600 "$AIRY_HOME/config/cupolas/permission_rules.yaml" 2>/dev/null || true
    fi
    [ -f "$rel/keys/agentrt.asc" ] && cp -f "$rel/keys/agentrt.asc" "$AIRY_HOME/keys/" 2>/dev/null || true
    if [ -f "$AIRY_HOME/config/install.env" ]; then
        if grep -q '^AIRY_VERSION=' "$AIRY_HOME/config/install.env" 2>/dev/null; then
            sed_inplace "s|^AIRY_VERSION=.*|AIRY_VERSION=v${new_ver}|" "$AIRY_HOME/config/install.env"
        else
            printf 'AIRY_VERSION=v%s\n' "$new_ver" >> "$AIRY_HOME/config/install.env"
        fi
        if grep -q '^AIRY_ARTIFACT_SHA256=' "$AIRY_HOME/config/install.env" 2>/dev/null; then
            sed_inplace "s|^AIRY_ARTIFACT_SHA256=.*|AIRY_ARTIFACT_SHA256=${expect_sha}|" "$AIRY_HOME/config/install.env"
        else
            printf 'AIRY_ARTIFACT_SHA256=%s\n' "$expect_sha" >> "$AIRY_HOME/config/install.env"
        fi
        chmod 600 "$AIRY_HOME/config/install.env" 2>/dev/null || true
    fi
    if [ -f "$AIRY_HOME/bin/agentrt-env.sh" ] \
       && ! grep -q 'LD_LIBRARY_PATH' "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null; then
        printf '\nexport LD_LIBRARY_PATH="${AIRY_HOME}/lib:${LD_LIBRARY_PATH:-}"\n' \
            >> "$AIRY_HOME/bin/agentrt-env.sh"
        chmod 700 "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null || true
        log info "agentrt-env.sh 已补写 LD_LIBRARY_PATH 注入（0.1.6c 自愈）"
    fi
    local _entry="$AIRY_HOME/bin/airymaxrt"
    local _entry_resolved="$_entry"
    if [ -L "$_entry" ]; then
        _entry_resolved="$(readlink "$_entry" 2>/dev/null || echo "$_entry")"
    fi
    if [ -s "$_SOURCE" ] && [ "$_SOURCE" != "$_entry_resolved" ]; then
        if cp -f "$_SOURCE" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已重生成（no-args 将自动拉起守护进程群）"
        else
            log warn "入口启动器重生成失败（可运行 airymaxrt start 或重装修复）"
        fi
    elif [ ! -x "$_entry" ] && [ -n "$prev_rel" ] && [ -s "$prev_rel/bin/airymaxrt" ]; then
        if cp -f "$prev_rel/bin/airymaxrt" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已从上一版本恢复（自举源不可用）"
        else
            log warn "入口启动器恢复失败，请运行 install.sh --reinstall"
        fi
    fi
    rel_prune
    upd_lock_rel
    log ok "更新完成: v${new_ver}（重跑 airymaxrt 生效）"
    return 0
}

# A-9 H1：按「命令行以该路径开头」锚定，且正则元字符按字面量转义。
# 旧写法 pkill -f "$AIRY_HOME/bin/$d" 会把 ssh 会话（命令行内携带同一
# 路径字符串）一并命中——这是 H1 自匹配的根因。
pkill_bin() {
    local _pat
    _pat="$(printf '%s' "$1" | sed 's/[][\\.*^$]/\\&/g')"
    pkill -f -- "^${_pat}([[:space:]]|$)" >/dev/null 2>&1
}

stop_running_daemons() {
    # B13 收摊归一：daemon 群生命周期归 supervisor_d，先走 shutdown；
    # pkill 循环仅兜底清理旧版（B13 前直拉起）残留实例
    local found=0 d n p exe
    if _sock_alive "$RUNTIME_DIR/supervisor.sock"; then
        if _sup_stop_wait; then
            found=1
            log info "supervisor 已收摊（daemon 群随之退出）"
        else
            log warn "supervisor 未能优雅退出，转兜底清理"
        fi
    fi
    for d in "$AIRY_HOME"/bin/*_d; do
        [ -f "$d" ] || continue
        d="${d##*/}"
        if [ -x "$AIRY_HOME/bin/$d" ]; then
            pkill_bin "$AIRY_HOME/bin/$d" && found=1
            if [ -r /proc/self/exe ] && command -v pgrep >/dev/null 2>&1; then
                for p in $(pgrep -x "$d" 2>/dev/null); do
                    exe="$(readlink "/proc/$p/exe" 2>/dev/null)"
                    [ "${exe%% *}" = "$AIRY_HOME/bin/$d" ] || continue
                    kill "$p" 2>/dev/null && found=1
                done
            fi
        fi
    done
    if [ "$found" = "1" ]; then
        sleep 2
        log info "旧版本 daemon 已自动停止（下次启动加载新版本）"
    fi
}

airymaxrt_update() {
    local CHECK=0 CHANNEL="" CH_EXPLICIT=0 ROLLBACK=0 FILE="" SHA256="" inst_env="$AIRY_HOME/config/install.env"
    while [ $# -gt 0 ]; do
        case "$1" in
            --check|-c) CHECK=1 ;;
            --channel) CHANNEL="${2:-}"; CH_EXPLICIT=1; shift ;;
            --rollback) ROLLBACK=1 ;;
            --file|-f) FILE="${2:-}"; shift ;;
            --sha256) SHA256="${2:-}"; shift ;;
            --yes|-y) : ;;
            *) log error "未知参数: $1（--check/--channel/--rollback/--file/--sha256）"; return 2 ;;
        esac
        shift
    done
    local cur_ver="" cur_ch="stable" cur_sha=""
    if [ -f "$inst_env" ]; then
        cur_ver="$(sed -n 's/^AIRY_VERSION=//p' "$inst_env" | head -1)"
        cur_ch="$(sed -n 's/^AIRY_CHANNEL=//p' "$inst_env" | head -1)"
        cur_sha="$(sed -n 's/^AIRY_ARTIFACT_SHA256=//p' "$inst_env" | head -1)"
    fi
    CHANNEL="${CHANNEL:-${cur_ch:-stable}}"
    case "$CHANNEL" in stable|rc|beta) ;; *) log error "通道无效: ${CHANNEL}（stable|rc|beta）"; return 2 ;; esac
    if [ "$CH_EXPLICIT" = "0" ] && [ "$CHANNEL" != "stable" ]; then
        log info "通道 ${CHANNEL}（继承自安装记录 config/install.env）；切回生产线：airymaxrt update --channel stable"
    fi

    if [ "$ROLLBACK" = "1" ]; then
        migrate_layout || return 1
        upd_lock_acq || return 1
        upd_recover || { upd_lock_rel; return 1; }
        local rb="$(rel_prev)"
        [ -n "$rb" ] || { log error "无可用回滚目标（releases/ 仅含当前版本）"; upd_lock_rel; return 1; }
        local from_id="$(rel_cur_id)"
        log info "回滚到: $(basename "$rb")…"
        if ! rel_commit "$rb"; then
            log error "回滚失败（current 切换被拒），当前版本未受影响"
            upd_lock_rel; return 1
        fi
        upd_env_sync "$rb"
        upd_intent_clear
        stop_running_daemons
        # 回滚是终态动作：移除被放弃版本，防止再次回滚乒乓回切到已知损坏版本
        if [ -n "$from_id" ]; then
            rm -rf "${AIRY_HOME}/releases/$from_id" || log warn "被放弃版本目录移除失败（不影响回滚）: $from_id"
        fi
        upd_lock_rel
        log ok "回滚完成（重新运行 airymaxrt 生效）"
        return 0
    fi

    if [ -n "$FILE" ]; then
        [ -f "$FILE" ] || { log error "本地包不存在: $FILE"; return 1; }
        local expect_sha="$SHA256"
        if [ -z "$expect_sha" ] && [ -f "${FILE}.sha256" ]; then
            expect_sha="$(cut -d' ' -f1 "${FILE}.sha256" 2>/dev/null)"
        fi
        if [ -z "$expect_sha" ]; then
            log error "离线包必须提供校验值：--sha256 <hash> 或相邻 ${FILE}.sha256（防供应链绕过）"
            return 1
        fi
        log info "应用本地离线包: $(basename "$FILE")（sha256 强制校验）…"
        local f_rc=0
        apply_package "$FILE" "$expect_sha" || f_rc=$?
        [ "$f_rc" = "0" ] && stop_running_daemons
        return "$f_rc"
    fi

    local TMPD="$AIRY_HOME/tmp/update.$$"
    rm -rf "$TMPD"; mkdir -p "$TMPD"
    log info "检查更新（通道: ${CHANNEL}，当前: ${cur_ver:-<未安装>}）…"
    fetch_release_asset "manifest.${CHANNEL}.json" "$TMPD/manifest.json" \
        || {
            log error "manifest 拉取失败：${AIRY_RELEASE_BASE}/latest/manifest.${CHANNEL}.json"
            log error "可能是网络/服务异常；也可能该通道暂无制品——当前可用：stable（生产）/ rc（候选），beta 为保留通道"
            log error "切换通道：airymaxrt update --channel stable"
            rm -rf "$TMPD"; return 1
        }
    fetch_release_asset "manifest.${CHANNEL}.json.asc" "$TMPD/manifest.json.asc" >/dev/null 2>&1 || true
    verify_gpg_sig "$TMPD/manifest.json" "$TMPD/manifest.json.asc" || { log error "manifest 验签失败（GPG），拒绝更新"; rm -rf "$TMPD"; return 1; }
    log info "manifest 验签通过（GPG）"
    if [ "$(manifest_get "$TMPD/manifest.json" state)" = "reserved" ]; then
        log error "通道 ${CHANNEL} 为保留通道（state=reserved），官方尚未发布任何制品"
        log error "当前可用：stable（生产）/ rc（候选）"
        log error "切换通道：airymaxrt update --channel stable"
        rm -rf "$TMPD"; return 1
    fi
    local latest="$(manifest_get "$TMPD/manifest.json" latest)"
    [ -n "$latest" ] || { log error "manifest 解析失败"; rm -rf "$TMPD"; return 1; }
    local cmp="$(ver_cmp "${cur_ver:-0.0.0}" "$latest")"
    if [ "$cmp" = "1" ]; then
        log warn "通道 ${CHANNEL} 最新为 ${latest}，低于已安装的 ${cur_ver}（不回退）"
        if [ "$CHANNEL" != "stable" ]; then
            log warn "若想跟随生产版本线：airymaxrt update --channel stable"
        fi
        rm -rf "$TMPD"; return 0
    fi
    local plat="$(runtime_platform)"
    local art_url art_sha art_size=""
    art_url="$(manifest_field "$TMPD/manifest.json" "$plat" url)"
    art_sha="$(manifest_field "$TMPD/manifest.json" "$plat" sha256)"
    art_size="$(manifest_field "$TMPD/manifest.json" "$plat" size)"
    if [ -z "$art_url" ] && [ -z "$art_sha" ]; then
        for legacy in $(plat_legacy_name "$plat"); do
            [ -n "$legacy" ] || continue
            art_url="$(manifest_field "$TMPD/manifest.json" "$legacy" url)"
            art_sha="$(manifest_field "$TMPD/manifest.json" "$legacy" sha256)"
            art_size="$(manifest_field "$TMPD/manifest.json" "$legacy" size)"
            { [ -n "$art_url" ] || [ -n "$art_sha" ]; } && { log warn "平台键 ${plat} 未命中，已用兼容命名 ${legacy}"; break; }
        done
    fi
    if [ "$cmp" = "0" ]; then
        if [ -z "$art_sha" ] || [ "$art_sha" = "${cur_sha:-}" ]; then
            log info "已是最新: ${cur_ver:-<未安装>}（最新 ${latest}，发布面 manifest 为唯一事实源）"
            rm -rf "$TMPD"; return 0
        fi
        log info "同版本制品变更: ${cur_ver:-<未安装>}（sha256 与已装记录不同，按修复重发更新）"
    else
        log info "发现新版本: ${cur_ver:-<未安装>} → ${latest}（${CHANNEL}）"
    fi
    [ -n "$art_url" ] || {
        log error "当前平台 ${plat} 无可用制品"
        case "$plat" in
            *riscv*)
                log error "RISC-V（${plat}）暂无官方预编译制品（CI 仅 canary 构建）"
                log error "请在目标机源码构建：AIRY_MODE=source bash install.sh（需 RISC-V 工具链 + 依赖库）"
                ;;
        esac
        log error "若您安装的是旧版本（≤v0.1.6d），安装器已过旧无法自举更新；"
        log error "请重新执行一键安装命令（见官网 install 指南）更新安装器后重试。"
        rm -rf "$TMPD"; return 1
    }
    [ "$CHECK" = "1" ] && { log info "仅检查模式：更新可用"; rm -rf "$TMPD"; return 0; }
    local tarball="$TMPD/$(basename "${art_url%%\?*}")"
    local _dl_flags="-fsSL"
    [ -t 2 ] && _dl_flags="-fL --progress-bar"
    if [ -n "$art_size" ]; then
        log info "下载制品（$(human_size "$art_size")）: ${art_url}"
    else
        log info "下载制品: ${art_url}"
    fi
    syscurl $_dl_flags --max-time 600 -o "$tarball" "$art_url" || { log error "制品下载失败"; rm -rf "$TMPD"; return 1; }
    log ok "制品下载完成: $(human_size "$(wc -c < "$tarball" 2>/dev/null | tr -d ' ')")"
    apply_package "$tarball" "$art_sha"
    local rc=$?
    rm -rf "$TMPD"
    [ "$rc" = "0" ] && stop_running_daemons
    return $rc
}

ensure_installer() {
    local act="$1" inst="${AIRY_HOME}/scripts/install.sh"
    if [ -f "$inst" ]; then
        log debug "安装器就绪: $inst"
        printf '%s\n' "$inst"
        return 0
    fi
    log warn "${act}: 本机未找到安装器脚本 $inst"
    if [ -n "${AIRY_NO_NETWORK:-}" ] || ! command -v curl >/dev/null 2>&1; then
        log error "${act}: 无法在线拉取安装器（AIRY_NO_NETWORK 已设或 curl 不可用）"
        return 1
    fi
    local fetched="$AIRY_HOME/tmp/install.$$.sh"
    mkdir -p "$AIRY_HOME/tmp" 2>/dev/null || true
    if fetch_release_asset "install.sh" "$fetched"; then
        chmod 755 "$fetched"
        log warn "${act}: 本机安装器缺失，已从发布面附件在线拉取兜底: $fetched"
        printf '%s\n' "$fetched"
        return 0
    fi
    rm -f "$fetched"
    log error "${act}: 在线拉取安装器失败（请检查网络后重试）"
    return 1
}

FRONTEND_TUI=1
CLI_ARGS=()
CMD="${1:-}"
# 0.1.19 A1 安装后自检：机器可读完整性快照（--json）。退出码只锚定安装
# 完整性——核心链与网关二进制全部在位且 install.env 就绪；gateway/daemon
# 运行态为信息字段不参与判定（安装末尾 daemon 群按设计为停机态，运行态
# 活性由 e2e clean-room 把关）。JSON 走 stdout，诊断走 stderr，零污染。
# 0.1.19 §3.5 缺陷5：daemon 请求侧检出 model.yaml 漂移后落标记文件，
# 此处汇总待重启 daemon 名（空格分隔），供 status 面提示。
_cfg_stale() {
    local f out=""
    for f in "$RUNTIME_DIR"/model_yaml_stale_*; do
        if [ -f "$f" ]; then
            out="$out ${f##*model_yaml_stale_}"
        fi
    done
    printf '%s' "${out# }"
}

# 版本唯一事实源：安装态 install.env 优先；解包即用态随包根 VERSION 兜底。
ver_resolve() {
    local v=""
    if [ -f "$AIRY_HOME/config/install.env" ]; then
        v="$(sed -n 's/^AIRY_VERSION=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    fi
    if [ -z "$v" ] && [ -f "$SCRIPT_DIR/../VERSION" ]; then
        v="$(head -1 "$SCRIPT_DIR/../VERSION" 2>/dev/null)"
    fi
    printf '%s' "${v#v}"
}

# 自托管服务可见性：managed.d 片段只是声明面，必须落到进程才算在线。
# 此前 status 只列核心 daemon 群，用户装好 llama-server 后无从确认它是否
# 被 supervisor 拉起——「自托管没有页面」的观感即来于此。
_managed_rows() {
    local _d="$AIRY_HOME/config/managed.d" _f _n _b _e _st
    [ -d "$_d" ] || return 0
    for _f in "$_d"/*.env; do
        [ -f "$_f" ] || continue
        _n="$(sed -n 's/^AIRYRT_MANAGED_NAME=//p' "$_f" 2>/dev/null | head -1)"
        [ -n "$_n" ] || continue
        _b="$(sed -n 's/^AIRYRT_MANAGED_BIN=//p' "$_f" 2>/dev/null | head -1)"
        _e="$(sed -n 's/^AIRYRT_MANAGED_EP=//p' "$_f" 2>/dev/null | head -1)"
        _st="offline"
        if [ -n "$_b" ] && { pgrep -f "$_b" >/dev/null 2>&1 ||
             pgrep -x "$(basename "$_b")" >/dev/null 2>&1; }; then
            _st="online"
        fi
        printf '%s|%s|%s\n' "$_n" "$_st" "${_e:-}"
    done
}

status_json() {
    local ok=1 k v
    local comp="" dm=""
    for k in cli:CLI_BIN gateway:GATEWAY_BIN llm:LLM_BIN think:THINK_BIN agent:AGENT_BIN tool:TOOL_BIN; do
        v="${k#*:}"
        k="${k%%:*}"
        if [ -n "${!v:-}" ] && [ -x "${!v}" ]; then
            comp="${comp}\"${k}\":true,"
        else
            comp="${comp}\"${k}\":false,"
            ok=0
        fi
    done
    comp="${comp%,}"
    # TUI 是可选能力件：缺失不算安装不完整（服务端/无 cargo 主机本就无此件），
    # 但必须可被 machine-readable 面看见，避免「status 全绿、--tui 到运行时才 126」。
    if [ -x "$AIRY_HOME/bin/agentrt-tui" ]; then
        comp="${comp},\"tui\":true"
    else
        comp="${comp},\"tui\":false"
    fi
    local env_ok=false pkg_ok=false ver
    [ -f "$AIRY_HOME/config/install.env" ] && env_ok=true
    [ -f "$SCRIPT_DIR/../VERSION" ] && pkg_ok=true
    # 安装态以 install.env 为完整性凭据；解包即用态无 install.env，
    # 以随包 VERSION 同位凭据，二者皆缺才算安装不完整。
    if [ "$env_ok" = false ] && [ "$pkg_ok" = false ]; then
        ok=0
    fi
    ver="$(ver_resolve)"
    for k in llm think agent tool; do
        if _sock_alive "$RUNTIME_DIR/$k.sock"; then
            dm="${dm}\"${k}\":true,"
        else
            dm="${dm}\"${k}\":false,"
        fi
    done
    dm="${dm%,}"
    local gw=offline
    local stale="" sd
    for sd in $(_cfg_stale); do
        stale="${stale}\"${sd}\","
    done
    stale="${stale%,}"
    wait_for_health "$GATEWAY_URL" 1 && gw=online
    local mg="" _mn _ms _me
    while IFS='|' read -r _mn _ms _me; do
        [ -n "$_mn" ] || continue
        mg="${mg}{\"name\":\"${_mn}\",\"state\":\"${_ms}\",\"ep\":\"${_me}\"},"
    done <<< "$(_managed_rows)"
    mg="${mg%,}"
    [ "$ok" = 1 ] && ok=true || ok=false
    printf '{"ok":%s,"version":"%s","home":"%s","profile":"%s","components":{%s},"config":{"install_env":%s},"gateway":"%s","daemons":{%s},"managed":[%s],"config_stale":[%s]}\n' \
        "$ok" "$ver" "$AIRY_HOME" "${AIRYRT_PROFILE:-auto}" "$comp" "$env_ok" "$gw" "$dm" "$mg" "$stale"
    [ "$ok" = true ] || return 1
}

case "$CMD" in
    --version|-V|version)
        _ver="$(ver_resolve)"
        [ -n "$_ver" ] || _ver="unknown"
        printf 'airymaxrt %s\n' "$_ver"
        exit 0
        ;;
    --help|-h|help)
        echo "用法: airymaxrt [airy_cli 参数]（默认进入 TUI 渲染层）"
        echo "      airymaxrt version     显示版本号（等同 --version）"
        echo "      airymaxrt cli [airy_cli 参数]  行式模式（不经 TUI 渲染层）"
        echo "      airymaxrt local [setup|install|status|...]  自托管模型管理"
        echo "                        （setup 为交互向导；直接透传 ops/airy-local）"
        echo "      airymaxrt profile [full|minimal|auto]  查看/切换运行画像（硬件自适应）"
        echo "      airymaxrt monitor   硬件监控：检测到能力增强自动恢复功能"
        echo "                        （monitor --daemon 后台常驻 / --stop 停止）"
        echo "      airymaxrt status      查看运行时状态"
        echo "      airymaxrt stop        收摊 daemon 群（supervisor.shutdown 唯一收摊入口）"
        echo "      airymaxrt doctor [--online] [--gc-empty-out]  组件健康检查"
        echo "                        （--online 联网校验 api key；--gc-empty-out 回收"
        echo "                          白名单内 0 字节且超期（默认 7 天）的 .out）"
        echo "      airymaxrt logs [N]    查看最近日志（默认 airymaxrt.log 末 50 行；"
        echo "                            logs <name> 看指定 daemon，如 logs llm_d）"
        echo "      airymaxrt update      自更新（--check 仅检查 / --channel stable|rc|beta"
        echo "                            切通道 / --rollback 回滚 / --file 离线包"
        echo "                            （离线包需 --sha256 或相邻 .sha256））"
        echo "      airymaxrt uninstall   一键卸载（--keep-data 保留记忆数据）"
        echo "      airymaxrt reinstall   强制重装（清缓存下载最新版 + 停旧 daemon）"
        exit 0
        ;;
    cli)
        if [ -z "$CLI_BIN" ]; then
            log error "airy_cli 未找到（CLI_BIN 为空）"
            exit 1
        fi
        FRONTEND_TUI=0
        shift
        CLI_ARGS=("$@")
        ;;
    local)
        # 自托管统一入口：把向导/安装/状态/卸载透传给 ops/airy-local，
        # 用户无需知道脚本在仓库或安装包的哪个位置——这是「没有交互页面」
        # 的直接原因：此前本地模型完全没有可发现的命令入口。
        _AL_BIN=""
        for _c in "$AIRY_HOME/bin/airy-local" \
                  "$AIRYRT_HOME/tools/scripts/ops/bin/airy-local" \
                  "$SCRIPT_DIR/../../../../tools/scripts/ops/bin/airy-local"; do
            if [ -x "$_c" ]; then
                _AL_BIN="$_c"
                break
            fi
        done
        if [ -z "$_AL_BIN" ]; then
            _AL_BIN="$(command -v airy-local 2>/dev/null || true)"
        fi
        if [ -z "$_AL_BIN" ]; then
            log error "airy-local 未找到（安装包缺少 tools/scripts/ops/bin/airy-local）"
            exit 1
        fi
        shift
        exec "$_AL_BIN" "$@"
        ;;
    stop)
        # B13 收摊归一唯一入口：supervisor.shutdown（daemon 群随之退出）
        if _sup_stop_wait; then
            log ok "运行时已收摊（daemon 群随 supervisor 退出）"
        else
            log warn "supervisor 超时未退出（可 'pkill supervisor_d' 兜底）"
            exit 1
        fi
        exit 0
        ;;
    -*)
        CLI_ARGS=("$@")
        ;;
    profile)
        case "${2:-}" in
            ""|status)
                if ! _HW="$(assess_hardware)"; then
                    log error "硬件探测失败，无法生成硬件快照"
                    exit 1
                fi
                _HW_P="${_HW%%|*}"
                _HW_REST="${_HW#*|}"
                _MEM_TOTAL="${_HW_REST%%|*}"
                _MEM_REST="${_HW_REST#*|}"
                _MEM_AVAIL="${_MEM_REST%%|*}"
                _CPU="${_MEM_REST#*|}"
                _CPU="${_CPU%%|*}"
                _ACCEL="${_HW_REST##*|}"
                log info "当前画像: ${AIRYRT_PROFILE:-auto}（硬件建议: ${_HW_P}）"
                log info "硬件快照: $(detect_arch) · 内存 ${_MEM_TOTAL}KiB/可用 ${_MEM_AVAIL}KiB · CPU ${_CPU} 核 · 加速器 ${_ACCEL}"
                exit 0
                ;;
            full|minimal|auto)
                if [ "$2" = "auto" ]; then
                    if ! _HW="$(assess_hardware)"; then
                        log error "硬件探测失败，无法自动评估画像"
                        exit 2
                    fi
                    log info "自动评估画像: ${_HW%%|*}"
                    write_profile_state auto
                    AIRYRT_PROFILE="auto"
                else
                    write_profile_state "$2"
                    AIRYRT_PROFILE="$2"
                fi
                if [ "$AIRYRT_PROFILE" = "full" ]; then
                    log info "full 画像：补齐能力 daemon…"
                    ensure_aux_daemons
                fi
                log info "画像已生效: ${AIRYRT_PROFILE}（下次启动持久生效）"
                exit 0
                ;;
            *)
                log error "无效画像 '$2'（支持 full|minimal|auto）"
                exit 2
                ;;
        esac
        ;;
    monitor)
        case "${2:-}" in
            --daemon|--background|-d)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ] && \
                   [ -n "$(cat "$_MON_PID_FILE" 2>/dev/null)" ] && \
                   kill -0 "$(cat "$_MON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    log warn "硬件监控已在后台运行（PID=$(cat "$_MON_PID_FILE" 2>/dev/null)）"
                    exit 0
                fi
                mkdir -p "$RUNTIME_DIR"
                nohup bash "$SCRIPT_DIR/airymaxrt" monitor \
                    >"$LOG_DIR/airymaxrt-monitor.log" 2>&1 &
                echo "$!" >"$_MON_PID_FILE"
                log info "硬件监控后台运行（PID=$!，日志 $LOG_DIR/airymaxrt-monitor.log）"
                exit 0
                ;;
            --stop)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ]; then
                    _MON_PID="$(cat "$_MON_PID_FILE" 2>/dev/null)"
                    if [ -n "$_MON_PID" ] && kill -0 "$_MON_PID" 2>/dev/null; then
                        kill "$_MON_PID" 2>/dev/null
                        log info "硬件监控已停止（PID=${_MON_PID}）"
                    else
                        log warn "硬件监控未在运行（陈旧 PID 文件）"
                    fi
                    rm -f "$_MON_PID_FILE"
                else
                    log warn "未找到后台监控 PID 文件（未在后台运行？）"
                fi
                exit 0
                ;;
        esac
        trap 'log info "硬件监控退出"; exit 0' INT TERM
        _INT="${AIRYRT_MONITOR_INTERVAL:-10}"
        _HINTED=""   # 已提示的画像值：差异持续时只提示一次，回归一致后重置
        log info "硬件监控启动（间隔 ${_INT}s，Ctrl+C 退出），当前画像: ${AIRYRT_PROFILE}"
        while true; do
            if ! _HW="$(assess_hardware)"; then
                log warn "硬件探测失败，本轮跳过重评估（下轮重试）"
                sleep "$_INT"
                continue
            fi
            _CUR="${_HW%%|*}"
            _SNAP="${_HW#*|}"
            _ACCEL_NOW="${_SNAP##*|}"
            _ACCEL_BASE="${AIRY_HW_ACCEL:-none}"
            if [ "$_ACCEL_NOW" != "$_ACCEL_BASE" ]; then
                log info "外设变化: 加速器 ${_ACCEL_BASE} → ${_ACCEL_NOW}"
                upsert_profile_var AIRY_HW_ACCEL "$_ACCEL_NOW"
                if [ "$_ACCEL_NOW" != "none" ]; then
                    log info "检测到加速器（${_ACCEL_NOW}），本地推理能力可用（可配置本地模型）"
                else
                    log warn "加速器已不可见，本地推理将不可用（远程 LLM 不受影响）"
                fi
            fi
            if [ "$_CUR" != "$AIRYRT_PROFILE" ]; then
                if [ "$_CUR" = "full" ]; then
                    if [ "$AIRYRT_PROFILE_RAW" != "auto" ]; then
                        if [ "$_HINTED" != "$_CUR" ]; then
                            log warn "检测到硬件能力增强（${_SNAP}），但画像为显式设置 ${AIRYRT_PROFILE}"
                            log warn "执行 'airymaxrt profile full' 可立即恢复全量功能"
                            _HINTED="$_CUR"
                        fi
                    else
                        log info "检测到硬件能力增强（${_SNAP}），自动恢复全量功能"
                        write_profile_state full
                        AIRYRT_PROFILE=full
                        ensure_aux_daemons
                        _HINTED=""
                    fi
                elif [ "$_HINTED" != "$_CUR" ]; then
                    log warn "检测到资源下降（${_SNAP}，建议 minimal），当前画像 ${AIRYRT_PROFILE}"
                    log warn "可执行 'airymaxrt profile minimal' 主动裁剪，或重启进入 minimal"
                    _HINTED="$_CUR"
                fi
            else
                _HINTED=""
            fi
            sleep "$_INT"
        done
        ;;
    status)
        if [ "${2:-}" = "--json" ]; then
            status_json
            exit $?
        fi
        log info "AIRY_HOME=$AIRY_HOME"
        log info "画像: ${AIRYRT_PROFILE:-auto} · 架构: $(detect_arch) · 加速器: $(detect_accel)"
        log info "组件: CLI=${CLI_BIN:-缺失} GATEWAY=${GATEWAY_BIN:-缺失} LLM=${LLM_BIN:-缺失}"
        if [ -f "$AIRY_HOME/config/install.env" ]; then
            _BL="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
            _BL="${_BL:-$HOME/.local/bin/airymaxrt}"
            _BD="${_BL%/airymaxrt}"
            # 以当前 shell 的真实 PATH 判定，不读安装期快照
            # AIRY_BIN_DIR_IN_PATH：安装后用户自行改了 PATH 或换了 shell，
            # 快照会长期误报。
            _BP="no"
            _P_SEG="$PATH"
            while [ -n "$_P_SEG" ]; do
                [ "${_P_SEG%%:*}" = "$_BD" ] && { _BP="yes"; break; }
                [ "${_P_SEG%%:*}" = "$_P_SEG" ] && _P_SEG="" || _P_SEG="${_P_SEG#*:}"
            done
            if [ "$_BP" = "no" ]; then
                log warn "PATH 引导: ${_BD} 不在 PATH 中——当前 shell 输入 airymaxrt 会报 command not found"
                log warn "  临时生效: export PATH=\"${_BD}:\$PATH\""
                _RC_S="$HOME/.bashrc"
                case "$(basename "${SHELL:-/bin/sh}")" in
                    zsh) _RC_S="$HOME/.zshrc" ;;
                    fish) _RC_S="$HOME/.config/fish/config.fish" ;;
                    sh|dash|ash) _RC_S="$HOME/.profile" ;;
                esac
                log warn "  永久生效: echo 'export PATH=\"${_BD}:\$PATH\"' >> \"${_RC_S}\" && source \"${_RC_S}\""
            else
                log info "PATH 引导: ${_BD} 已在 PATH 中（输入 airymaxrt 即可启动）"
            fi
        fi
        if wait_for_health "$GATEWAY_URL" 1; then
            log info "gateway: 在线（${GATEWAY_URL}）"
        else
            log warn "gateway: 离线"
        fi
        _core_ok=1
        for _c in llm think agent tool; do
            if ! _sock_alive "$RUNTIME_DIR/$_c.sock"; then
                log warn "$_c.sock: 未就绪"
                _core_ok=0
            fi
        done
        if [ "$_core_ok" = "1" ]; then
            log info "daemon 群: 核心链路（llm/think/agent/tool）全部就绪"
        else
            log warn "daemon 群: 核心链路未全部就绪（运行 airymaxrt 拉起，或查看 logs/ 诊断）"
        fi
        _mf="$(_managed_rows)"
        if [ -n "$_mf" ]; then
            printf '%s\n' "$_mf" | while IFS='|' read -r _mn _ms _me; do
                if [ "$_ms" = "online" ]; then
                    log info "自托管 $_mn: 在线（${_me:-local}）"
                else
                    log warn "自托管 $_mn: 未运行（${_me:-local}）——airymaxrt local status 查看"
                fi
            done
        fi
        _stale="$(_cfg_stale)"
        if [ -n "$_stale" ]; then
            log warn "配置漂移: model.yaml 在 daemon 启动后被修改（$_stale），重启后生效"
        fi
        # D5：模型端点健康（可达性/延迟/冷加载）。_sock_alive 只证明 llm_d
        # 在线，不证明所配端点此刻可用——此项补齐"能力存在 ≠ 能力可用"。
        _ep_out="$(_ep_health "$RUNTIME_DIR/llm.sock")"
        _ep_rc=$?
        case "$_ep_rc" in
            0)
                log info "模型端点健康:"
                printf '%s\n' "$_ep_out" | while IFS= read -r _el; do log info "$_el"; done
                ;;
            2) log info "模型端点健康: 无本地端点（未配置 local provider）" ;;
            *) log warn "模型端点健康: 探测不可用（llm.sock 未就绪、响应异常或 llm_d 侧探测降级）" ;;
        esac
        exit 0
        ;;
    doctor)
        # A-6：自检不再恒绿。FAIL 收敛为退出码 1；WARN 只提示——未配密钥、
        # 端点离线属用户配置选择，不是安装损坏，不能与「装坏了」同码。
        _dn_f=0
        _dn_w=0
        _dn_pass() { log info "[PASS] $*"; }
        _dn_warn() { log warn "[WARN] $*"; _dn_w=$((_dn_w + 1)); }
        _dn_fail() { log error "[FAIL] $*"; _dn_f=$((_dn_f + 1)); }
        _dn_norm() { printf '%s' "${1#v}" | sed -n 's/^\([0-9][0-9.]*\).*/\1/p'; }
        _dn_online=0
        _dn_gc=0
        if [ $# -ge 1 ]; then
            shift # 丢掉 "doctor" 自身，其余按选项解析
        fi
        while [ $# -gt 0 ]; do
            case "$1" in
                --online) _dn_online=1 ;;
                --gc-empty-out) _dn_gc=1 ;;
                *) log warn "doctor: 忽略未知参数 $1" ;;
            esac
            shift
        done
        # A-5：空 .out 回收。只删「白名单 daemon 名 + size 0 + mtime 超期」，
        # 超期天数取 AIRY_GC_EMPTY_OUT_DAYS（默认 7）；白名单外一律不碰。
        _dn_gc_empty_out() {
            _gc_days="${AIRY_GC_EMPTY_OUT_DAYS:-7}"
            case "$_gc_days" in ''|*[!0-9]*) _gc_days=7 ;; esac
            _gc_n=0
            _gc_scan=0
            if [ ! -d "$LOG_DIR" ]; then
                _dn_pass "空日志回收: 日志根不存在（$LOG_DIR，无需回收）"
                return 0
            fi
            for _gc_f in "$LOG_DIR"/*.out; do
                [ -f "$_gc_f" ] || continue
                _gc_b="${_gc_f##*/}"
                case "$_gc_b" in
                    gateway_d.out|llm_d.out|think_d.out|agent_d.out|tool_d.out|\
                    notify_d.out|supervisor_d.out|memory_d.out|maths.out) ;;
                    *) continue ;;
                esac
                _gc_scan=$((_gc_scan + 1))
                [ -s "$_gc_f" ] && continue
                [ -n "$(find "$_gc_f" -maxdepth 0 -mtime +"$_gc_days" 2>/dev/null)" ] ||
                    continue
                rm -f -- "$_gc_f" && _gc_n=$((_gc_n + 1))
            done
            _dn_pass "空日志回收: 白名单 ${_gc_scan} 个 .out，删除 ${_gc_n} 个（0 字节且 >${_gc_days} 天）"
        }
        _dn_get() { printf '%s' "$2" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }

        # 路径来源自证：LOG_DIR/RUNTIME_DIR 必须出自 airy_cli 同一事实源，
        # 否则 doctor 与 daemon 会各看一半日志（A-6 修复的双根问题）。
        if [ -n "${_PJ:-}" ]; then
            _dn_pass "路径来源: airy_cli paths log=$LOG_DIR"
        else
            _dn_warn "路径来源: airy_cli 不可用，已按机制同款规则兜底 log=$LOG_DIR"
        fi
        if [ -d "$AIRY_HOME/logs" ] && [ "$AIRY_HOME/logs" != "$LOG_DIR" ]; then
            _dn_warn "旧日志根残留: $AIRY_HOME/logs（新根 $LOG_DIR；确认无进程写入后可删）"
        fi
        if [ "$_dn_gc" = "1" ]; then
            _dn_gc_empty_out
        fi

        # 发布标识：install.env 与运行期构建自证必须同源，否则装的是 A 版、
        # 配置记的是 B 版，升级与排障都会指向错误版本。
        _dn_env="$AIRY_HOME/config/install.env"
        _dn_iv=""
        [ -f "$_dn_env" ] && _dn_iv="$(sed -n 's/^AIRY_VERSION=//p' "$_dn_env" 2>/dev/null | head -1)"
        if [ -z "$_dn_iv" ]; then
            _dn_warn "发布标识: install.env 无 AIRY_VERSION（开发态运行）"
        elif [ -n "$CLI_BIN" ] && [ -x "$CLI_BIN" ]; then
            _dn_br="$("$CLI_BIN" --version 2>/dev/null |
                awk '{for (i = 1; i <= NF; i++) if ($i ~ /^v?[0-9]+(\.[0-9]+)+$/) {print $i; exit}}' ||
                true)"
            if [ "$(_dn_norm "$_dn_br")" = "$(_dn_norm "$_dn_iv")" ] &&
               [ -n "$(_dn_norm "$_dn_br")" ]; then
                _dn_pass "发布标识: $_dn_iv（install.env 与 airy_cli 一致）"
            else
                _dn_fail "发布标识: install.env=$_dn_iv，airy_cli=${_dn_br:-未知}（请 reinstall）"
            fi
        else
            _dn_fail "发布标识: 无可执行 airy_cli，版本无法自证"
        fi

        # 安装清单：schema + 条目数。缺失只在安装态（有 install.env）为 FAIL，
        # 开发态属正常；清单损坏会让卸载无法逐件回收，残留必查。
        _dn_mf="$AIRY_HOME/install-manifest.json"
        if [ -f "$_dn_mf" ]; then
            if head -n 3 "$_dn_mf" | grep -q '"schema": 1' && grep -q '"entries"' "$_dn_mf"; then
                _dn_n="$(grep -c '"path":' "$_dn_mf" 2>/dev/null || true)"
                case "${_dn_n:-}" in ''|*[!0-9]*) _dn_n=0 ;; esac
                if [ "$_dn_n" -gt 0 ]; then
                    _dn_mr="$(sed -n 's/.*"release": "\([^"]*\)".*/\1/p' "$_dn_mf" | head -1)"
                    if [ -n "$_dn_mr" ] && [ -n "$_dn_iv" ] &&
                       [ "$(_dn_norm "$_dn_mr")" != "$(_dn_norm "$_dn_iv")" ]; then
                        _dn_fail "安装清单陈旧: release=$_dn_mr，install.env=$_dn_iv（升级未刷新清单）"
                    else
                        _dn_pass "安装清单: schema=1，${_dn_n} 件"
                    fi
                else
                    _dn_fail "安装清单 entries 为空: $_dn_mf"
                fi
            else
                _dn_fail "安装清单损坏: $_dn_mf（请 reinstall）"
            fi
        elif [ -f "$_dn_env" ]; then
            _dn_fail "安装清单缺失: $_dn_mf（安装态必备，请 reinstall）"
        else
            _dn_warn "安装清单: 无（开发态运行）"
        fi

        for _dn_nm in CLI_BIN GATEWAY_BIN LLM_BIN THINK_BIN AGENT_BIN TOOL_BIN SUPERVISOR_BIN; do
            eval "_dn_v=\${$_dn_nm:-}"
            if [ -n "$_dn_v" ] && [ -x "$_dn_v" ]; then
                _dn_pass "$_dn_nm: $_dn_v"
            else
                _dn_fail "$_dn_nm: 缺失或不可执行"
            fi
        done
        # TUI 缺失是能力缺口而非安装损坏：判定为 WARN，并给出两条可执行修法，
        # 避免用户到 airy_cli --tui 才看到 126。
        if [ -x "$AIRY_HOME/bin/agentrt-tui" ]; then
            _dn_pass "agentrt-tui: $AIRY_HOME/bin/agentrt-tui"
        else
            _dn_warn "agentrt-tui: 缺失——/tui 与 airymaxrt --tui 不可用（源码安装需 cargo；二进制安装请确认包内含该件）"
            log warn "  修法: 安装 cargo 后执行 airymaxrt reinstall，或改用 airymaxrt cli 进行一次性对话"
        fi
        if [ ! -f "$AIRY_HOME/config/secrets.env" ]; then
            _dn_warn "secrets.env: 缺失——API 模式请在 $AIRY_CFG_DIR/secrets.env 写 <KEY>=<值>，或把模型行改为 mode: local"
        else
            _dn_pass "secrets.env: 就绪"
        fi
        if command -v curl >/dev/null 2>&1; then
            _dn_pass "curl: 就绪"
        else
            _dn_warn "curl: 缺失（安装/更新与联网探测不可用）"
        fi
        _BL_D="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
        _BL_D="${_BL_D:-$HOME/.local/bin/airymaxrt}"
        _BD_D="${_BL_D%/airymaxrt}"
        _PATH_FOUND=0
        _P_SEG="$PATH"
        while [ -n "$_P_SEG" ]; do
            _seg="${_P_SEG%%:*}"
            if [ "$_seg" = "$_BD_D" ]; then
                _PATH_FOUND=1
                break
            fi
            if [ "$_seg" = "$_P_SEG" ]; then _P_SEG=""; else _P_SEG="${_P_SEG#*:}"; fi
        done
        # 短命令自证：链接与 PATH 是两件独立的事。链接缺失时目录即使在
        # PATH 里也敲不出 airymaxrt；链接在位但目录不在 PATH 时同样报
        # command not found。分项判定，避免把两种故障混为一句「检查 PATH」。
        _RC_D="$HOME/.bashrc"
        case "$(basename "${SHELL:-/bin/sh}")" in
            zsh) _RC_D="$HOME/.zshrc" ;;
            fish) _RC_D="$HOME/.config/fish/config.fish" ;;
            sh|dash|ash) _RC_D="$HOME/.profile" ;;
        esac
        if [ ! -x "$_BL_D" ]; then
            _dn_warn "短命令: 缺少 ${_BL_D}（执行 airymaxrt reinstall 重建链接）"
        elif [ "$_PATH_FOUND" != "1" ]; then
            _dn_warn "短命令: ${_BD_D} 不在 PATH 中——输入 airymaxrt 会报 command not found"
            log warn "  永久生效: echo 'export PATH=\"${_BD_D}:\$PATH\"' >> \"${_RC_D}\" && source \"${_RC_D}\""
        elif ! command -v airymaxrt >/dev/null 2>&1; then
            _dn_warn "短命令: ${_BL_D} 在位但当前 shell 解析不到（重开终端或 hash -r）"
        else
            _dn_pass "短命令: airymaxrt → $(command -v airymaxrt)"
        fi
        _LD_MISS=""
        if command -v ldd >/dev/null 2>&1; then
            for _b in "$AIRY_HOME"/bin/*_d "$AIRY_HOME"/bin/airy_cli "$AIRY_HOME"/bin/agentrt-tui; do
                [ -x "$_b" ] || continue
                _nf="$(ldd "$_b" 2>/dev/null | grep -F 'not found' || true)"
                if [ -n "$_nf" ]; then
                    _LD_MISS="$_LD_MISS
  $(basename "$_b"): $(echo "$_nf" | sed 's/.*=> not found/缺/' | tr '\n' '; ')"
                fi
            done
            if [ -n "$_LD_MISS" ]; then
                _dn_fail "运行库缺失（daemon 无法启动）:$_LD_MISS"
                log warn "  修复: airymaxrt reinstall（干净重装，保留 config/data）"
            else
                _dn_pass "运行库: 全部可解析"
            fi
        else
            _dn_warn "运行库: 平台无 ldd，跳过动态库解析检查"
        fi

        # 运行目录与 daemon 控制口：目录不可写则 daemon 起不来；控制口全无
        # 说明未拉起（WARN），部分在线说明有成员掉队（WARN）。
        if mkdir -p "$RUNTIME_DIR" 2>/dev/null && [ -w "$RUNTIME_DIR" ]; then
            _dn_pass "运行目录: $RUNTIME_DIR 可写"
        else
            _dn_fail "运行目录不可写: $RUNTIME_DIR"
        fi
        _dn_up=0
        for _dn_s in supervisor llm think agent tool; do
            _sock_alive "$RUNTIME_DIR/$_dn_s.sock" && _dn_up=$((_dn_up + 1))
        done
        case "$_dn_up" in
            5) _dn_pass "daemon 群: 5/5 控制口在线" ;;
            0) _dn_warn "daemon 群: 未运行（airymaxrt 拉起后复查）" ;;
            *) _dn_warn "daemon 群: ${_dn_up}/5 控制口在线（部分成员未就绪）" ;;
        esac

        # 日志根可写 + 审计无界增长。*_d.out 是 nohup 兜底捕获，大小只反映
        # 是否崩溃过，不作 PASS/FAIL 判据——健康判据在结构化日志与 socket。
        if mkdir -p "$LOG_DIR" 2>/dev/null && [ -w "$LOG_DIR" ]; then
            _dn_pass "日志目录: $LOG_DIR 可写"
        else
            _dn_fail "日志目录不可写: $LOG_DIR（daemon 审计与排障将失明）"
        fi
        _dn_amax="${AIRY_AUDIT_MAX_BYTES:-67108864}"
        case "$_dn_amax" in ''|*[!0-9]*) _dn_amax=67108864 ;; esac
        for _dn_af in "$LOG_DIR/daemon_audit.log" "$LOG_DIR/audit.log"; do
            [ -f "$_dn_af" ] || continue
            _dn_asz="$(wc -c < "$_dn_af" 2>/dev/null | tr -d ' ')"
            case "${_dn_asz:-}" in ''|*[!0-9]*) _dn_asz=0 ;; esac
            if [ "$_dn_asz" -gt "$_dn_amax" ]; then
                _dn_fail "审计日志超限: $_dn_af ${_dn_asz}B > ${_dn_amax}B（无轮转，磁盘会被写满）"
            else
                _dn_pass "审计日志: $(basename "$_dn_af") ${_dn_asz}B（上限 ${_dn_amax}B）"
            fi
        done

        # 模型配置与 agent 包：缺失即 LLM/角色不可用，属可修复告警。
        if [ -f "$MODEL_CONFIG" ]; then
            _dn_pass "模型配置: $MODEL_CONFIG"
        else
            _dn_warn "模型配置缺失: $MODEL_CONFIG（或 AIRY_MODEL_CONFIG 指定）"
        fi
        if [ -d "$AIRY_HOME/lib/agents" ] || [ -d "$AIRYRT_HOME/ecosystem/agents" ]; then
            _dn_pass "agent 包: 已就位"
        else
            _dn_warn "agent 包: 未找到（$AIRY_HOME/lib/agents）"
        fi

        # 连接三态（A-7）：local 免 key；api 缺 key 给出两条可执行修法；
        # 只有 --online 才联网校验——离线自检不能把网络故障算成安装损坏。
        # 密钥只经 stdin 交给 curl（-K -），不进 argv，ps 不可见。
        _dn_key() {
            local _k
            _k="${!1:-}"
            if [ -z "$_k" ] && [ -f "$AIRY_CFG_DIR/secrets.env" ]; then
                _k="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" \
                    "$AIRY_CFG_DIR/secrets.env" 2>/dev/null | head -1)"
                _k="${_k%"${_k##*[![:space:]]}"}"
                _k="${_k#\"}"
                _k="${_k%\"}"
            fi
            printf '%s' "$_k"
        }
        _dn_probe() {
            local _k _c
            _k="$(_dn_key "$2")"
            [ -n "$_k" ] || { printf '401'; return 0; }
            _k="${_k//\\/\\\\}"
            _k="${_k//\"/\\\"}"
            _c="$(printf 'header = "Authorization: Bearer %s"\n' "$_k" |
                curl -sS -K - -o /dev/null -w '%{http_code}' --max-time 5 \
                    "${1%/}/models" 2>/dev/null || true)"
            case "$_c" in 2?? | 401 | 403 | 000) ;; *) _c=000 ;; esac
            printf '%s' "$_c"
        }
        _dn_rows=""
        if [ -f "$MODEL_CONFIG" ] && [ -n "${CLI_BIN:-}" ] && [ -x "$CLI_BIN" ]; then
            _dn_rows="$("$CLI_BIN" models --json --file "$MODEL_CONFIG" 2>/dev/null || true)"
            if [ -z "$_dn_rows" ]; then
                _dn_warn "模型连接表: 无法解析 $MODEL_CONFIG（确认 models: 列表格式）"
            else
                while IFS= read -r _dn_row; do
                    [ -n "$_dn_row" ] || continue
                    _dn_mn="$(_dn_get name "$_dn_row")"
                    _dn_mm="$(_dn_get mode "$_dn_row")"
                    _dn_mu="$(_dn_get base_url "$_dn_row")"
                    _dn_me="$(_dn_get key_env "$_dn_row")"
                    _dn_mh="$(printf '%s' "$_dn_row" |
                        sed -n 's/.*"has_key":\([0-9]*\).*/\1/p')"
                    if [ "$_dn_mm" = "local" ]; then
                        _dn_pass "provider ${_dn_mn}: 本地模型（免 key）"
                    elif [ "$_dn_mh" != "1" ]; then
                        _dn_warn "provider ${_dn_mn}: 缺 key——在 $AIRY_CFG_DIR/secrets.env 写 ${_dn_me}=<密钥>，或把该行 mode 改为 local"
                    elif [ "$_dn_online" != "1" ]; then
                        _dn_warn "provider ${_dn_mn}: 已配置 key（未联网校验；doctor --online 可验）"
                    else
                        _dn_code="$(_dn_probe "$_dn_mu" "$_dn_me")"
                        case "$_dn_code" in
                            2??) _dn_pass "provider ${_dn_mn}: key 有效（HTTP ${_dn_code}）" ;;
                            401 | 403)
                                _dn_fail "provider ${_dn_mn}: key 无效（HTTP ${_dn_code}）——检查 $AIRY_CFG_DIR/secrets.env 的 ${_dn_me}"
                                ;;
                            000) _dn_warn "provider ${_dn_mn}: 端点不可达（${_dn_mu}）——检查网络或 base_url" ;;
                            *) _dn_pass "provider ${_dn_mn}: 端点可达（HTTP ${_dn_code}，未校验鉴权）" ;;
                        esac
                    fi
                done <<EOF
$_dn_rows
EOF
            fi
        fi

        # B-3：GPU 段与选路降级。探测在机制侧（airy_cli gpu），doctor 只读
        # 呈现，不尝试修复。选路顺序与 llm_d 一致：显式配置 > 能力匹配 >
        # 远端 API > CPU 自托管；每次降级必须打印原因，否则用户无法判断
        # 「为何明明有卡却没用上」。
        _dn_num() { printf '%s' "$2" | sed -n "s/.*\"$1\":\([0-9]*\).*/\1/p"; }
        _dn_gver="r3"
        _dn_gdev=0
        _dn_gbound=0
        _dn_gbe=""
        _dn_grsn=""
        _dn_gdrv=""
        _dn_gacc=""
        _dn_gvram=""
        _dn_gmem="未知"
        _dn_gpu=""
        if [ -n "${CLI_BIN:-}" ] && [ -x "$CLI_BIN" ]; then
            _dn_gpu="$("$CLI_BIN" gpu --json 2>/dev/null || true)"
        fi
        if [ -z "$_dn_gpu" ]; then
            _dn_warn "GPU: airy_cli gpu 不可用，无法判定加速器（按 CPU 自托管）"
        else
            _dn_gver="$(_dn_get verdict "$_dn_gpu")"
            _dn_gbe="$(_dn_get backend "$_dn_gpu")"
            _dn_grsn="$(_dn_get reason "$_dn_gpu")"
            _dn_gdrv="$(_dn_get drivers "$_dn_gpu")"
            _dn_gacc="$(_dn_get accel "$_dn_gpu")"
            _dn_gdev="$(_dn_num devices "$_dn_gpu")"
            _dn_gbound="$(_dn_num drv_bound "$_dn_gpu")"
            _dn_gvram="$(_dn_num vram_mb "$_dn_gpu")"
            case "${_dn_gdev:-}" in ''|*[!0-9]*) _dn_gdev=0 ;; esac
            case "${_dn_gbound:-}" in ''|*[!0-9]*) _dn_gbound=0 ;; esac
            case "${_dn_gvram:-}" in ''|*[!0-9]*) _dn_gvram=0 ;; esac
            [ "$_dn_gvram" -eq 0 ] || _dn_gmem="${_dn_gvram}MiB"
            if [ "$_dn_gver" = "r1" ] || [ "$_dn_gver" = "r2" ]; then
                if [ -n "$_dn_gbe" ]; then
                    _dn_pass "GPU: 加速器 ${_dn_gacc:-未知}，驱动 ${_dn_gdrv}，显存 ${_dn_gmem}，后端 ${_dn_gbe}（结论 ${_dn_gver}，L1/L2/L3 已打通）"
                else
                    _dn_warn "GPU: 结论 ${_dn_gver} 但无后端（探测器结论不自洽）"
                fi
            elif [ "$_dn_gdev" -gt 0 ] && [ "$_dn_gbound" -lt "$_dn_gdev" ]; then
                _dn_warn "GPU: 检出 ${_dn_gdev} 块加速器（${_dn_gdrv}），仅 ${_dn_gbound} 块驱动已绑定——驱动不可用（${_dn_grsn}）；降级原因：驱动未就绪"
            elif [ "$_dn_gdev" -gt 0 ]; then
                _dn_warn "GPU: 加速器在（${_dn_gacc:-未知} ${_dn_gdrv}，显存 ${_dn_gmem}）但无加速后端应答（${_dn_grsn}）；降级原因：后端未就绪"
            else
                _dn_pass "GPU: 未检出加速器（${_dn_grsn}）；降级原因：本机无 GPU，按 CPU 自托管"
            fi
        fi

        _dn_local=0
        _dn_remote=0
        _dn_lname=""
        _dn_rname=""
        while IFS= read -r _dn_row; do
            [ -n "$_dn_row" ] || continue
            _dn_mm="$(_dn_get mode "$_dn_row")"
            _dn_mh="$(printf '%s' "$_dn_row" | sed -n 's/.*"has_key":\([0-9]*\).*/\1/p')"
            if [ "$_dn_mm" = "local" ]; then
                _dn_local=$((_dn_local + 1))
                [ -n "$_dn_lname" ] || _dn_lname="$(_dn_get name "$_dn_row")"
            elif [ "$_dn_mh" = "1" ]; then
                _dn_remote=$((_dn_remote + 1))
                [ -n "$_dn_rname" ] || _dn_rname="$(_dn_get name "$_dn_row")"
            fi
        done <<EOF
$_dn_rows
EOF
        if [ "$_dn_local" -gt 0 ]; then
            _dn_pass "选路: 显式配置 → ${_dn_lname}（model.yaml 声明 ${_dn_local} 条 local provider）"
        elif [ "$_dn_gver" = "r1" ] || [ "$_dn_gver" = "r2" ]; then
            _dn_pass "选路: 能力匹配 → ${_dn_gbe}（GPU 后端可用，未声明 local provider）"
        elif [ "$_dn_remote" -gt 0 ]; then
            _dn_warn "选路: 远端 API → ${_dn_rname}（降级原因：GPU 档不可用：${_dn_grsn:-未探测}）"
        else
            _dn_warn "选路: CPU 自托管（降级原因：无 local provider、无可用 GPU 后端、无已配密钥的 api provider）"
        fi

        if [ "$_dn_f" -gt 0 ]; then
            log error "doctor: ${_dn_f} 项失败，${_dn_w} 项告警（逐项见上）"
            exit 1
        fi
        log info "doctor: 全部通过（${_dn_w} 项告警）"
        exit 0
        ;;
    logs)
        _arg="${2:-}"
        _n=50
        _file="$LOG_DIR/airymaxrt.log"
        case "$_arg" in
            "") ;;
            *[!0-9]*)
                if [ -f "$LOG_DIR/$_arg" ]; then
                    _file="$LOG_DIR/$_arg"
                elif [ -f "$LOG_DIR/${_arg}.out" ]; then
                    _file="$LOG_DIR/${_arg}.out"
                elif [ -f "$LOG_DIR/${_arg}.log" ]; then
                    _file="$LOG_DIR/${_arg}.log"
                else
                    log error "未找到日志: ${_arg}（可用: $(ls "$LOG_DIR" 2>/dev/null | tr '\n' ' ')）"
                    exit 1
                fi
                _n="${3:-50}"
                ;;
            *)
                _n="$_arg"
                ;;
        esac
        case "$_n" in
            *[!0-9]*|"") _n=50 ;;
        esac
        if [ ! -f "$_file" ]; then
            log error "日志文件不存在: $_file"
            exit 1
        fi
        echo "── ${_file}（末 ${_n} 行）────────────────────────────" >&2
        tail -n "$_n" "$_file"
        exit 0
        ;;
    uninstall)
        inst="$(ensure_installer uninstall)" || {
            log error "请重新执行官方一键安装命令（见官网 install 指南）后再卸载，"
            log error "或手动删除: $AIRY_HOME"
            exit 1
        }
        log info "委托安装器执行卸载: $inst"
        shift
        if [ "$AIRY_HOME" != "${HOME}/.airymaxrt" ]; then
            exec sh "$inst" --uninstall --prefix "$AIRY_HOME" "$@"
        fi
        exec sh "$inst" --uninstall "$@"
        ;;
    reinstall)
        inst="$(ensure_installer reinstall)" || {
            log error "请重新执行官方一键安装命令（见官网 install 指南）以完成重装"
            exit 1
        }
        log info "委托安装器执行重装: $inst"
        shift
        if [ "$AIRY_HOME" != "${HOME}/.airymaxrt" ]; then
            exec sh "$inst" --reinstall --prefix "$AIRY_HOME" "$@"
        fi
        exec sh "$inst" --reinstall "$@"
        ;;
    update)
        shift
        airymaxrt_update "$@" || { _u_rc=$?; exit "$_u_rc"; }
        exit 0
        ;;
esac

# 运行路径专属注入：管理命令（update 等）不 source 旧制品 env/secrets 脚本，
# 防止其损坏（含 exit 语句）时更新通道自锁。
# 外部脚本在宽松标志下 source（半写入截断脚本可致非零返回），
# 字面 exit 无法在 source 语义下拦截，由管理命令免注入保证自救通道。
safe_source() {
    set +e +u
    . "$1"
    local _rc=$?
    set -e -u
    return "$_rc"
}
_SECRET_FILE="$AIRY_HOME/config/secrets.env"
if [ -f "$_SECRET_FILE" ]; then
    log info "加载密钥文件: $_SECRET_FILE"
    set -a
    safe_source "$_SECRET_FILE" || log warn "密钥文件加载异常，已忽略失败部分: $_SECRET_FILE"
    set +a
fi
if [ -f "$AIRY_HOME/bin/agentrt-env.sh" ]; then
    log debug "注入运行环境: $AIRY_HOME/bin/agentrt-env.sh"
    _AIRY_HOME_RESOLVED="$AIRY_HOME"
    safe_source "$AIRY_HOME/bin/agentrt-env.sh" || log warn "运行环境脚本异常，已忽略注入失败部分"
    AIRY_HOME="$_AIRY_HOME_RESOLVED"
    export AIRY_HOME
    RUNTIME_DIR="${AIRY_HOME}/run"
    log debug "agentrt-env.sh 注入后恢复 AIRY_HOME=$AIRY_HOME RUNTIME_DIR=$RUNTIME_DIR"
fi
# 无安装面（源码树直接运行）时 cupolas_d 无口令可读，显式声明开发口径；
# 安装布局带 config/install.env，由穹顶自行读取口令，不开这个开关。
if [ -z "${AIRY_VAULT_PASSWORD:-}" ] && [ ! -f "$AIRY_HOME/config/install.env" ]; then
    export AIRY_ALLOW_EMPTY_VAULT=1
fi
upd_boot_recover
_near=""
case "$CMD" in
    ""|-*) ;;
    *)
        _exact=""
        for _cmd in help cli profile monitor status doctor logs uninstall reinstall update; do
            [ "$_cmd" = "$CMD" ] && { _exact=1; break; }
            case "$_cmd" in "$CMD"*) _near="$_near $_cmd" ;; esac
        done
        if [ -z "$_exact" ] && [ -n "$_near" ]; then
            log error "未知命令: ${CMD}（是否想用:${_near}？）"
            log error "运行 airymaxrt help 查看全部命令"
            exit 2
        fi
        ;;
esac
if [ -z "${AIRYRT_TERM_LOG:-}" ]; then
    AIRYRT_TERM_LOG=quiet
fi

if [ -z "$CLI_BIN" ]; then
    log error "未找到 airy_cli，请先构建："
    log error "  CLI: cd \"$AIRYRT_HOME/agentrt\" && cmake --build build --target airy_cli"
    exit 1
fi
log info "组件就绪: CLI=$(basename "$CLI_BIN")"

path_self_heal

clear_front_screen() {
    if [ -t 1 ]; then
        printf '\033[2J\033[H' >&1
    fi
}

# A-9 H3：daemon 存活数为唯一口径——启动器不得在守护群仍存活时
# 以「界面退出」暗示整体退出。计数取 run/ 下非 supervisor 的活 socket。
daemon_count() {
    local _s _n=0
    for _s in "$RUNTIME_DIR"/*.sock; do
        [ -S "$_s" ] || continue
        [ "${_s##*/}" = "supervisor.sock" ] && continue
        _sock_alive "$_s" && _n=$((_n + 1))
    done
    printf '%s' "$_n"
}

# stdin 指向 /dev/null（非交互调用）判定：管道输入不在此列，仍交给 CLI。
stdin_is_null() {
    [ -t 0 ] && return 1
    local _t
    _t="$(readlink /proc/self/fd/0 2>/dev/null || true)"
    [ "$_t" = "/dev/null" ] && return 0
    [ -c /dev/stdin ]
}

launch_frontend() {
    log debug "TTY 检测: stdin=$([ -t 0 ] && echo tty || echo pipe) stdout=$([ -t 1 ] && echo tty || echo pipe)"
    if [ -d "$AIRY_HOME/tmp" ]; then
        find "$AIRY_HOME/tmp" -mindepth 1 -mtime +1 -exec rm -rf {} + 2>/dev/null
        log debug "tmp 清理: 已回收超过 24h 未修改的临时文件/目录"
    fi
    # A-9 H3：无参数 + stdin=/dev/null 时 CLI 必然读到 EOF 后立即退出，
    # 旧行为打印「交互界面退出」而 13 个 daemon 仍存活（误导）。此处
    # 直接跳过前端，以 daemon count 为口径打印运行态。
    if [ "${#CLI_ARGS[@]}" -eq 0 ] && stdin_is_null; then
        _FRONTEND_SKIPPED=1
        # 不静默：stdin=/dev/null 在 IDE 内建终端、管道与部分 Windows 终端里很常见，
        # 旧行为只打 debug，用户看到的就是「短命令没起界面」。显式给出判据与修法。
        log warn "未进入交互界面：stdin 不是终端（/dev/null 或非 TTY）"
        log warn "  需要 TUI：在真实终端执行 airymaxrt --tui；一次性对话：airymaxrt cli"
        boot_line "守护进程群运行中（daemon count=$(daemon_count)）"
        return 0
    fi
    export AIRY_GATEWAY_URL="$GATEWAY_URL"
    if [ -n "$AGENT_FILE" ]; then
        export AIRY_AGENT_FILE="$AGENT_FILE"
    else
        unset AIRY_AGENT_FILE
    fi
    # A-9 H4：标记启动来源，CLI 据此绑定父进程死亡联动（PDEATHSIG）。
    export AIRY_LAUNCHED_BY="airymaxrt"
    if [ "$FRONTEND_TUI" = "1" ] && [ -t 0 ] && [ -t 1 ]; then
        if [ "${#CLI_ARGS[@]}" -eq 0 ]; then
            clear_front_screen
            log info "进入交互界面（Ctrl+C 退出）"
        fi
        # bash 3.2（macOS 系统自带）在 set -u 下把空数组的 "${arr[@]}"
        # 判为 unbound variable（4.4 才修正）；此处按 POSIX 惯用式展开。
        set -- --tui ${CLI_ARGS[@]+"${CLI_ARGS[@]}"}
    else
        set -- ${CLI_ARGS[@]+"${CLI_ARGS[@]}"}
    fi
    "$CLI_BIN" "$@" <&0 &
    TUI_PID=$!
    wait "$TUI_PID" || return $?
    return 0
}

GATEWAY_ALIVE=0
# run/gateway.port 由 gateway_d 绑定成功后发布，描述「当前运行栈的真实端口」。
# 启动器先采纳该事实，避免按缺省端口误判离线后在运行中的栈旁再起一个 gateway。
if [ -s "$RUNTIME_DIR/gateway.port" ]; then
    _rt_gw_port="$(sed -n '1s/[^0-9]//gp' "$RUNTIME_DIR/gateway.port" 2>/dev/null | head -1)"
    if [ -n "$_rt_gw_port" ] && wait_for_health "http://127.0.0.1:${_rt_gw_port}" 1; then
        GATEWAY_PORT="$_rt_gw_port"
        GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
    fi
fi
if wait_for_health "$GATEWAY_URL" 1; then
    GATEWAY_ALIVE=1
    log info "gateway 在线（${GATEWAY_URL}），本次复用（不重复拉起）"
else
    log info "gateway 离线（${GATEWAY_URL}），将一并拉起"
fi
log info "确保守护进程群就绪…"
boot_line "正在启动守护进程群…"

TUI_PID=""

cleanup() {
    # B13 集群服务化（§12.13）：daemon 群生命周期归 supervisor_d 持有，
    # 不随 TUI 会话退出收摊；收摊归一唯一入口为 'airymaxrt stop'
    if [ -n "$TUI_PID" ] && kill -0 "$TUI_PID" 2>/dev/null; then
        kill "$TUI_PID" 2>/dev/null || true
        wait "$TUI_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -z "$GATEWAY_BIN" ] && [ -z "$LLM_BIN" ]; then
    log warn "gateway_d 与 llm_d 均未找到，将以 OFFLINE 模式进入（对话功能不可用）。"
    log warn "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
else
    for _pf in "$RUNTIME_DIR"/*.pid; do
        [ -f "$_pf" ] || continue
        _p="$(cat "$_pf" 2>/dev/null)"
        if [ -z "$_p" ] || ! kill -0 "$_p" 2>/dev/null; then
            rm -f "$_pf"
            log debug "清理 stale pid 文件: $_pf"
        fi
    done
    _LOG_KEEP_DAYS="${AIRYRT_LOG_KEEP_DAYS:-7}"
    if command -v find >/dev/null 2>&1 && [ -d "$LOG_DIR" ]; then
        _CUTOFF=$(( $(date +%s) - _LOG_KEEP_DAYS * 86400 ))
        while IFS= read -r _old; do
            [ -n "$_old" ] || continue
            rm -f "$_old"
            log debug "清理过期运行时日志: $_old"
        done < <(find "$LOG_DIR" -maxdepth 1 -type f \
                     \( -name 'agent_*.log' -o -name '*.out' -o -name '*.pid' \) \
                     ! -newermt "@$_CUTOFF" -print 2>/dev/null)
    fi
    # B13 V13.4：daemon 群唯一拉起路径 = supervisor_d 声明驱动调谐；
    # 本脚本仅写入期望态声明并拉起 supervisor 本身（唯一 nohup 例外）
    SUPERV_SOCK="$RUNTIME_DIR/supervisor.sock"
    CORE_LIST=""
    REUSED_COUNT=0
    SUPERV_REUSE=0
    if _sock_alive "$SUPERV_SOCK"; then
        SUPERV_REUSE=1
        log info "supervisor 已在运行（复用 ${SUPERV_SOCK}），daemon 群由其接管"
    fi

    sup_stale_sock_rm() {
        # stale socket（无监听）清理：避免后续 spawn bind 失败
        [ -S "$1" ] || return 0
        _sock_alive "$1" && return 0
        log warn "检测到 stale socket（无监听），移除: $1"
        rm -f "$1"
    }
    sup_stale_sock_rm "$SUPERV_SOCK"

    core_decl() {
        # $1=名字 $2=bin $3=sock：在线复用剔除；二进制缺失告警不声明
        sup_stale_sock_rm "$3"
        if _sock_alive "$3"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "$1 已在运行（复用 $3）"
            return 0
        fi
        [ -z "$2" ] && return 1
        CORE_LIST="$CORE_LIST $1"
        return 0
    }
    core_decl llm_d "$LLM_BIN" "$RUNTIME_DIR/llm.sock" \
        || log warn "llm_d 未找到，模型接入不可用"
    core_decl think_d "$THINK_BIN" "$RUNTIME_DIR/think.sock" \
        || log warn "think_d 未找到，双思考（GCCP+GRAD）不可用，gateway 将降级直连"
    core_decl agent_d "$AGENT_BIN" "$RUNTIME_DIR/agent.sock" \
        || log warn "agent_d 未找到"
    core_decl tool_d "$TOOL_BIN" "$RUNTIME_DIR/tool.sock" \
        || log warn "tool_d 未找到"

    _gw_port_available() {
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import socket,sys; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(('127.0.0.1',int(sys.argv[1]))); s.close()" "$1" 2>/dev/null
        elif (echo >/dev/tcp/127.0.0.1/"$1") 2>/dev/null; then
            return 1
        elif command -v nc >/dev/null 2>&1; then
            if nc -z 127.0.0.1 "$1" >/dev/null 2>&1; then return 1; fi
            return 0
        else
            return 0
        fi
    }
    GW_REUSE="$GATEWAY_ALIVE"   # 复用判定：主端口健康或扫描到在线实例
    if [ "$GW_REUSE" = "1" ]; then
        log info "gateway 已在线（${GATEWAY_URL}），复用（生命周期归 supervisor/外部持有）"
    else
        for _p in "$GATEWAY_PORT" 8083 8084 8085 8086 8087 8088 8089 8090; do
            if _gw_port_available "$_p"; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log warn "端口 $GATEWAY_PORT 被占用（残留连接），gateway 改用端口 $_p"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                break
            fi
            if wait_for_health "http://127.0.0.1:$_p" 1; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log info "端口 $_p 已有在线 gateway，直接复用"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                GW_REUSE=1
                break
            fi
        done
    fi
    if [ "$GW_REUSE" = "1" ]; then
        REUSED_COUNT=$((REUSED_COUNT + 1))
        log info "gateway_d 已在运行（复用 ${GATEWAY_URL}）"
    elif [ -n "$GATEWAY_BIN" ]; then
        CORE_LIST="$CORE_LIST gateway_d"
        # gateway 运行参数经声明注入（supervisor spawn 时下发）
        upsert_profile_var AIRYRT_LAUNCH_ARGS_gateway_d "-h 127.0.0.1 -p $GATEWAY_PORT"
    else
        log warn "gateway_d 未找到，对话功能不可用（仅 CLI 降级可用）"
    fi
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    # 端口事实的唯一写入者是绑定方 gateway_d；启动器只消费该文件，
    # 不预写——预写会在 gateway 未起或改端口时留下与真实监听不符的值。

    # 期望态声明写入画像（supervisor 启动时只读装载）
    launch_decl_sync "$CORE_LIST"

    if [ "$SUPERV_REUSE" != "1" ]; then
        if [ -z "$SUPERVISOR_BIN" ]; then
            log error "supervisor_d 未找到，daemon 群无法拉起（B13 拉起唯一路径为 supervisor_d）"
            log error "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
            exit 1
        fi
        log debug "执行: nohup \"$SUPERVISOR_BIN\" > \"$LOG_DIR/supervisor_d.out\" 2>&1 &"
        nohup "$SUPERVISOR_BIN" >"$LOG_DIR/supervisor_d.out" 2>&1 &
        log info "supervisor_d 已拉起（PID=$!），日志: $LOG_DIR/supervisor_d.out"
        _sup_deadline=$((SECONDS + 10))
        until _sock_alive "$SUPERV_SOCK"; do
            if [ "$SECONDS" -ge "$_sup_deadline" ]; then
                log error "supervisor 控制口未就绪（${SUPERV_SOCK}），查看日志: $LOG_DIR/supervisor_d.out"
                exit 1
            fi
            sleep 0.25
        done
        log info "supervisor 控制口就绪（${SUPERV_SOCK}）"
    fi

    sup_wait_core() {
        # 声明调谐等待：CORE spawn 完成（gateway 无 unix sock，HTTP 健康另行等待）
        [ -z "$CORE_LIST" ] && return 0
        local deadline=$((SECONDS + 15)) n left
        while [ "$SECONDS" -lt "$deadline" ]; do
            left=0
            for n in $CORE_LIST; do
                [ "$n" = "gateway_d" ] && continue
                _sock_alive "$RUNTIME_DIR/${n%_d}.sock" || left=$((left + 1))
            done
            [ "$left" -eq 0 ] && return 0
            sleep 0.25
        done
        log warn "CORE daemon 未全部就绪（${left} 个待就绪）: ${CORE_LIST}"
        return 1
    }
    CORE_PENDING=0
    sup_wait_core || CORE_PENDING=1

    if [ "$AIRYRT_PROFILE" != "minimal" ]; then
        ensure_aux_daemons \
            || log warn "部分 aux daemon 激活失败（'airymaxrt doctor' 可复查）"
    fi

    if [ "$CORE_PENDING" = "0" ]; then
        if [ "$REUSED_COUNT" -gt 0 ]; then
            boot_line "守护进程群就绪（复用 ${REUSED_COUNT} 个 + 声明调谐完成）"
        else
            boot_line "守护进程群就绪（supervisor 声明调谐完成）"
        fi
    else
        diag_daemons
        boot_line "守护进程群部分未就绪，详见上方诊断"
    fi

    if wait_for_health "$GATEWAY_URL" 15; then
        log info "gateway 就绪（${GATEWAY_URL}）"
        boot_line "gateway 就绪（${GATEWAY_URL}）"
    else
        log warn "gateway 未能就绪（${GATEWAY_URL}），查看日志: $LOG_DIR/gateway_d.out"
        boot_line "gateway 未就绪（${GATEWAY_URL}），降级模式…"
        if [ -n "$CLI_BIN" ]; then
            log warn "降级：airy_cli 直连 daemon 群（不依赖 gateway）"
        else
            log error "交互界面依赖 gateway，但 airy_cli 缺失，无法降级"
            log error "可执行 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 下残留 socket 后重试"
            exit 1
        fi
    fi
fi

_FRONTEND_SKIPPED=0
launch_frontend
rc=$?
if [ "$_FRONTEND_SKIPPED" = "1" ]; then
    log info "交互界面已跳过（stdin=/dev/null），daemon count=$(daemon_count)"
else
    log info "交互界面退出（exit=${rc}），daemon count=$(daemon_count)"
fi
exit $rc
