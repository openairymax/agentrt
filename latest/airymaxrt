field_cmp() {
    local x="$1" y="$2" xn="" yn="" xl="" yl=""
    while [ -n "$x" ] && [[ "$x" == [a-zA-Z]* ]]; do x="${x#?}"; done
    while [ -n "$y" ] && [[ "$y" == [a-zA-Z]* ]]; do y="${y#?}"; done
    xn="${x%%[a-zA-Z]*}"; xl="${x#$xn}"
    yn="${y%%[a-zA-Z]*}"; yl="${y#$yn}"
    xn="$(printf '%s' "$xn" | tr -cd '0-9')"; xn="${xn:-0}"
    yn="$(printf '%s' "$yn" | tr -cd '0-9')"; yn="${yn:-0}"
    if (( 10#$xn > 10#$yn )); then echo 1; return; fi
    if (( 10#$xn < 10#$yn )); then echo -1; return; fi
    if [ -z "$xl" ] && [ -z "$yl" ]; then echo 0; return; fi
    if [ -z "$xl" ]; then echo -1; return; fi   # 5 < 5a
    if [ -z "$yl" ]; then echo 1; return; fi    # 5a > 5
    if [[ "$xl" < "$yl" ]]; then echo -1; return; fi
    if [[ "$xl" > "$yl" ]]; then echo 1; return; fi
    echo 0
}

ver_cmp() {
    local a="$1" b="$2" apr="" bpr=""
    a="${a#v}"; b="${b#v}"
    case "$a" in *-*) apr="${a#*-}"; a="${a%%-*}";; esac
    case "$b" in *-*) bpr="${b#*-}"; b="${b%%-*}";; esac
    local -a av bv
    IFS='.' read -r -a av <<< "$a"
    IFS='.' read -r -a bv <<< "$b"
    local n=$(( ${#av[@]} > ${#bv[@]} ? ${#av[@]} : ${#bv[@]} )) i c
    for ((i=0; i<n; i++)); do
        c="$(field_cmp "${av[$i]:-0}" "${bv[$i]:-0}")"
        if [ "$c" = "1" ]; then echo 1; return; fi
        if [ "$c" = "-1" ]; then echo -1; return; fi
    done
    if [ -z "$apr" ] && [ -z "$bpr" ]; then echo 0; return; fi
    if [ -z "$apr" ]; then echo 1; return; fi   # 正式版 > prerelease
    if [ -z "$bpr" ]; then echo -1; return; fi
    local pa pb
    case "$apr" in alpha*) pa=1;; beta*) pa=2;; rc*) pa=3;; *) pa=4;; esac
    case "$bpr" in alpha*) pb=1;; beta*) pb=2;; rc*) pb=3;; *) pb=4;; esac
    if (( pa > pb )); then echo 1; return; fi
    if (( pa < pb )); then echo -1; return; fi
    local an bn
    an="${apr##*.}"; [ "$an" = "$apr" ] && an="0"
    bn="${bpr##*.}"; [ "$bn" = "$bpr" ] && bn="0"
    echo "$(field_cmp "$an" "$bn")"
}

plat_name() {
    case "$1" in
        x86_64)  echo "x86-64" ;;
        i686)    echo "x86-32" ;;
        aarch64) echo "arm-64" ;;
        armv7l)  echo "arm-32" ;;
        riscv64) echo "riscv-64" ;;
        riscv32) echo "riscv-32" ;;
        *)       echo "$1" ;;
    esac
}

plat_legacy_name() {
    case "$1" in
        linux-x86-64|macos-x86-64|win-x86-64) printf '%s\n' "${1%-x86-64}-x64" "${1%-x86-64}-x86_64" ;;
        linux-x86-32|macos-x86-32|win-x86-32) printf '%s\n' "${1%-x86-32}-x86" "${1%-x86-32}-i686" ;;
        linux-arm-64|macos-arm-64|win-arm-64) printf '%s\n' "${1%-arm-64}-arm64" "${1%-arm-64}-aarch64" ;;
        linux-arm-32|macos-arm-32|win-arm-32) printf '%s\n' "${1%-arm-32}-arm32" "${1%-arm-32}-armv7l" ;;
        linux-riscv-64|win-riscv-64)          echo "${1%-riscv-64}-riscv64" ;;
        linux-riscv-32|win-riscv-32)          echo "${1%-riscv-32}-riscv32" ;;
        *)                                    echo "" ;;
    esac
}

plat_markers() {
    case "$1" in
        x86_64)  printf 'platform-x86-64 platform-x64 platform-x86_64 platform-amd64' ;;
        i686)    printf 'platform-x86-32 platform-x86 platform-i686 platform-i386' ;;
        aarch64) printf 'platform-arm-64 platform-arm64 platform-aarch64' ;;
        armv7l)  printf 'platform-arm-32 platform-arm32 platform-armv7l' ;;
        riscv64) printf 'platform-riscv-64 platform-riscv64' ;;
        riscv32) printf 'platform-riscv-32 platform-riscv32' ;;
        *)       echo "" ;;
    esac
}

arch_markers_ok() {
    local _t="$1" _a="$2" _ms _m _p _bad=""
    _ms="$(tar -tzf "$_t" 2>/dev/null | awk -F/ '{print $NF}' \
        | grep -E '^platform-[A-Za-z0-9_-]+$' | sort -u || true)"
    [ -n "$_ms" ] || return 0
    for _m in $_ms; do
        for _p in $(plat_markers "$_a"); do
            if [ "$_m" = "$_p" ]; then return 0; fi
        done
        _bad="$_bad $_m"
    done
    printf '%s' "${_bad# }"
    return 1
}

human_size() {
    local _b="${1:-}"
    case "$_b" in ''|*[!0-9]*) echo "未知"; return 0 ;; esac
    if [ "$_b" -ge 1048576 ]; then
        echo "$((_b / 1048576)).$((_b % 1048576 / 104858))MiB"
    elif [ "$_b" -ge 1024 ]; then
        echo "$((_b / 1024))KiB"
    else
        echo "${_b}B"
    fi
}

runtime_platform() {
    local os arch
    case "$(uname -s 2>/dev/null)" in
        Darwin) os="macos"; arch="$(uname -m 2>/dev/null)" ;;   # arm64 / x86_64
        *)      os="linux"; arch="$(detect_arch)" ;;
    esac
    echo "${os}-$(plat_name "${arch}")"
}

manifest_get() {
    local f="$1" mode="$2"
    case "$mode" in
        latest) sed -n 's/.*"latest"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1 ;;
        state)  sed -n 's/.*"state"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1 ;;
    esac
}

# 制品字段按平台键作用域提取：python3 可用时精确解析，缺失时在平台块内 sed 取值，
# 保证更新通道不依赖本地 python3（V12.1）。
manifest_field() {
    local f="$1" plat="$2" field="$3"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$f" "$plat" "$field" <<'PYEOF'
import json, sys
try:
    m = json.load(open(sys.argv[1]))
    rel = m.get("releases", {}).get(m.get("latest", ""), {})
    print(rel.get("artifacts", {}).get(sys.argv[2], {}).get(sys.argv[3], ""))
except Exception:
    pass
PYEOF
        return 0
    fi
    sed -n "/\"$plat\"[[:space:]]*:[[:space:]]*{/,/^[[:space:]]*}/{
        s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p
        s/.*\"$field\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p
    }" "$f" | head -1
}

fetch_release_asset() {
    local tag="${3:-latest}" tmp
    tmp="${AIRY_HOME}/tmp/asset.$$"
    mkdir -p "$(dirname "$tmp")" 2>/dev/null
    syscurl -fsSL --max-time 60 -o "$tmp" "${AIRY_RELEASE_BASE}/${tag}/${1}" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$2" || { rm -f "$tmp"; return 1; }
    [ -s "$2" ]
}

verify_gpg_sig() {
    local f="$1" sig="$2"
    [ -s "$sig" ] || { log warn "缺少签名文件（fail-closed），拒绝更新"; return 1; }
    local GNUPG="$AIRY_HOME/tmp/gnupg-update"
    mkdir -p "$GNUPG"
    chmod 700 "$GNUPG"
    local KEYF="$GNUPG/agentrt.asc"
    if [ -z "${AIRY_NO_NETWORK:-}" ]; then
        fetch_release_asset "agentrt.asc" "$KEYF" >/dev/null 2>&1 || true
    fi
    if [ ! -s "$KEYF" ] && [ -f "$AIRY_HOME/keys/agentrt.asc" ]; then
        cp -f "$AIRY_HOME/keys/agentrt.asc" "$KEYF" 2>/dev/null || true
    fi
    [ -s "$KEYF" ] || printf '%s\n' "$AIRY_GPG_PUBKEY" > "$KEYF"
    gpg --batch --quiet --no-tty --homedir "$GNUPG" --import "$KEYF" >/dev/null 2>&1 || return 1
    gpg --batch --no-tty --homedir "$GNUPG" --verify "$sig" "$f" >/dev/null 2>&1
}

# ---- 事务化更新基元（B10）：版本目录 releases/<id> + current 符号链接原子切换 ----
# 不变量：镜像替换只发生"新目录就位 + current 重指"两点，永不就地改写已发布版本目录；
# 回滚 = current 重指上一版本，全流程 mkdir 互斥 + intent 幂等重放。

upd_lock_acq() {
    local q="${1:-}" lk="$AIRY_HOME/run/update.lock" pid
    mkdir -p "$AIRY_HOME/run" 2>/dev/null || true
    if mkdir "$lk" 2>/dev/null; then
        printf '%s\n' "$$" > "$lk/pid" 2>/dev/null || true
        return 0
    fi
    pid="$(cat "$lk/pid" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        [ "$q" = "quiet" ] || log error "另一更新进程持锁运行中（pid ${pid}），本次操作拒绝"
        return 1
    fi
    [ "$q" = "quiet" ] || log warn "清理残留更新锁（持锁进程 ${pid:-?} 已不存在）"
    rm -rf "$lk" 2>/dev/null || true
    mkdir "$lk" 2>/dev/null || { [ "$q" = "quiet" ] || log error "更新锁获取失败"; return 1; }
    printf '%s\n' "$$" > "$lk/pid" 2>/dev/null || true
    return 0
}

upd_lock_rel() {
    rm -rf "$AIRY_HOME/run/update.lock" 2>/dev/null || true
}

upd_intent_set() {
    mkdir -p "$AIRY_HOME/run" 2>/dev/null || true
    printf 'target=%s\n' "$1" > "$AIRY_HOME/run/update.intent"
}

upd_intent_clear() {
    rm -f "$AIRY_HOME/run/update.intent" 2>/dev/null || true
}

rel_commit() {
    local target="$1"
    [ -d "$target" ] || { log error "提交目标不存在: $target"; return 1; }
    # -n: dest 为目录符号链接时直接替换链接本身（mv 会移入目录内部）
    if ! ln -sfn "$target" "$AIRY_HOME/current" 2>/dev/null; then
        log error "current 切换失败（releases 布局异常）"
        return 1
    fi
    return 0
}

rel_links_ensure() {
    local d
    for d in bin lib include share; do
        if [ -e "$AIRY_HOME/$d" ] && [ ! -L "$AIRY_HOME/$d" ]; then
            log error "布局异常: $AIRY_HOME/$d 为真实目录（预期符号链接），请先重装"
            return 1
        fi
        [ -L "$AIRY_HOME/$d" ] || ln -s "current/$d" "$AIRY_HOME/$d" 2>/dev/null || true
    done
    return 0
}

rel_cur_id() {
    readlink "$AIRY_HOME/current" 2>/dev/null | sed 's|.*/||'
}

rel_prev() {
    local cur cands d best=""
    cur="$(rel_cur_id)"
    cands="$(ls -1dt "$AIRY_HOME"/releases/*/ 2>/dev/null)"
    for d in $cands; do
        d="${d%/}"
        [ "$(basename "$d")" = "$cur" ] && continue
        case "$(basename "$d")" in .*) continue ;; esac
        [ -f "$d/.complete" ] || continue
        best="$d"
        break
    done
    [ -n "$best" ] && printf '%s\n' "$best"
    return 0
}

rel_prune() {
    local cur keep=0 d
    cur="$(rel_cur_id)"
    ls -1dt "$AIRY_HOME"/releases/*/ 2>/dev/null | while read -r d; do
        d="${d%/}"
        [ "$(basename "$d")" = "$cur" ] && continue
        case "$(basename "$d")" in .*) continue ;; esac
        keep=$((keep + 1))
        [ "$keep" = "1" ] && continue
        rm -rf "$d"
    done
}

rel_env_write() {
    local rel="$1" ver="$2" sha="$3"
    {
        printf 'AIRY_VERSION=%s\n' "$ver"
        [ -n "$sha" ] && printf 'AIRY_ARTIFACT_SHA256=%s\n' "$sha"
        printf 'AIRY_RELEASE_ID=%s\n' "$(basename "$rel")"
    } > "$rel/release.env"
}

upd_env_sync() {
    local rel="$1" env="$AIRY_HOME/config/install.env" k v
    [ -f "$rel/release.env" ] || { log warn "版本快照缺失（release.env），install.env 保持不变"; return 0; }
    [ -f "$env" ] || { mkdir -p "$AIRY_HOME/config" 2>/dev/null || true; : > "$env"; }
    for k in AIRY_VERSION AIRY_ARTIFACT_SHA256; do
        v="$(sed -n "s/^$k=//p" "$rel/release.env" 2>/dev/null | head -1)"
        [ -n "$v" ] || continue
        if grep -q "^$k=" "$env" 2>/dev/null; then
            sed_inplace "s|^$k=.*|$k=$v|" "$env"
        else
            printf '%s=%s\n' "$k" "$v" >> "$env"
        fi
    done
    chmod 600 "$env" 2>/dev/null || true
}

migrate_layout() {
    [ -L "$AIRY_HOME/current" ] && return 0
    [ -e "$AIRY_HOME/bin" ] || return 0
    local rel id d ts
    ts="$(date +%Y%m%d%H%M%S)"
    id="$(sed -n 's/^AIRY_VERSION=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    id="${id#v}"; [ -n "$id" ] || id="unknown"
    rel="$AIRY_HOME/releases/$id-mig$ts"
    mkdir -p "$AIRY_HOME/releases" 2>/dev/null || { log error "releases/ 目录创建失败"; return 1; }
    mkdir -p "$rel"
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] && cp -r "$AIRY_HOME/$d" "$rel/" 2>/dev/null || true
    done
    if [ ! -e "$rel/bin" ] || [ ! -e "$rel/lib" ]; then
        log error "布局迁移失败（复制不完整），保持原布局继续"
        rm -rf "$rel"
        return 1
    fi
    rel_env_write "$rel" "v${id}" "$(sed -n 's/^AIRY_ARTIFACT_SHA256=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    : > "$rel/.complete"
    if ! rel_commit "$rel"; then
        log error "布局迁移失败（current 切换被拒），保持原布局继续"
        rm -rf "$rel"
        return 1
    fi
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] || continue
        if ! mv "$AIRY_HOME/$d" "$AIRY_HOME/$d.mig.bak" 2>/dev/null; then
            log error "布局迁移失败（$d 重命名被拒），保持原布局继续"
            rm -rf "$rel"
            return 1
        fi
        if ! ln -s "current/$d" "$AIRY_HOME/$d" 2>/dev/null; then
            mv "$AIRY_HOME/$d.mig.bak" "$AIRY_HOME/$d" 2>/dev/null || true
            log error "布局迁移失败（$d 符号链接建立被拒），保持原布局继续"
            rm -rf "$rel"
            return 1
        fi
        rm -rf "$AIRY_HOME/$d.mig.bak"
    done
    rm -rf "$AIRY_HOME/.rollback" 2>/dev/null || true
    log ok "安装布局已迁移至版本化目录（releases/$(basename "$rel")）"
    return 0
}

upd_recover() {
    local it="$AIRY_HOME/run/update.intent" target rel d
    [ -f "$it" ] || return 0
    target="$(sed -n 's/^target=//p' "$it" 2>/dev/null | head -1)"
    if [ -n "$target" ] && [ -d "$AIRY_HOME/releases/$target" ]; then
        rel="$AIRY_HOME/releases/$target"
        if [ -f "$rel/.complete" ]; then
            if rel_commit "$rel"; then
                upd_env_sync "$rel"
                log ok "已恢复上次中断的更新（当前版本: ${target}）"
            else
                log error "在途更新恢复失败（current 切换被拒），intent 已保留待重试"
                return 1
            fi
        else
            rm -rf "$rel"
            log warn "上次更新在提交前中断，已清理未完成版本（当前版本未受影响）"
        fi
    else
        log warn "上次更新意图记录不完整，已忽略"
    fi
    upd_intent_clear
    [ -d "$AIRY_HOME/releases" ] && \
        find "$AIRY_HOME/releases" -maxdepth 1 -name '.staging.*' -exec rm -rf {} + 2>/dev/null || true
    for d in bin lib include share; do
        if [ -d "$AIRY_HOME/$d.mig.bak" ]; then
            rm -rf "$AIRY_HOME/$d"
            mv "$AIRY_HOME/$d.mig.bak" "$AIRY_HOME/$d" 2>/dev/null || true
            log warn "已恢复迁移中断目录: $d"
        fi
    done
    return 0
}

upd_boot_recover() {
    [ -f "$AIRY_HOME/run/update.intent" ] || return 0
    upd_lock_acq quiet || return 0
    upd_recover || log warn "在途更新恢复未完成（保留 intent 待下次重试）"
    upd_lock_rel
}

apply_package() {
    local tarball="$1" expect_sha="$2" arch="$(detect_arch)"
    find "$AIRY_HOME/releases" -maxdepth 1 -name '.staging.*' -mtime +0 -exec rm -rf {} + 2>/dev/null || true
    migrate_layout || return 1
    upd_lock_acq || return 1
    upd_recover || { upd_lock_rel; return 1; }
    local TMPD="$AIRY_HOME/releases/.staging.$$"
    rm -rf "$TMPD"
    if ! mkdir -p "$AIRY_HOME/releases" "$TMPD" 2>/dev/null; then
        log error "releases/ 目录创建失败（磁盘/权限），当前版本未受影响"
        upd_lock_rel; return 1
    fi
    if [ -z "$expect_sha" ]; then
        log error "缺少 sha256 期望值，拒绝安装（防供应链绕过）"; rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    if [ "$(sha256_file "$tarball")" != "$expect_sha" ]; then
        log error "sha256 校验失败，拒绝安装"; rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    log ok "sha256 校验通过"
    _am_bad=""
    if ! _am_bad="$(arch_markers_ok "$tarball" "$arch")"; then
        log error "制品架构与当前主机（${arch}）不匹配（包内标记 $(echo $_am_bad | tr ' ' '/')），拒绝更新"
        log error "  期望标记之一: $(plat_markers "$arch")"
        log error "  制品: $tarball"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    log info "架构校验通过（${arch}）"
    if ! tar -xzf "$tarball" -C "$TMPD"; then
        log error "解压失败（制品损坏或磁盘不足），当前版本未受影响"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    local extracted="$(find "$TMPD" -maxdepth 1 -type d -name 'agentrt-*' | head -1)"
    [ -n "$extracted" ] || { log error "包结构异常（缺 agentrt-* 顶层目录）"; rm -rf "$TMPD"; upd_lock_rel; return 1; }
    local new_ver="$(basename "$extracted" | sed -e 's/^agentrt-//' -e 's/^v//')"
    local new_id="${new_ver}-$(printf '%s' "$expect_sha" | cut -c1-8)"
    local rel="$AIRY_HOME/releases/$new_id"
    [ -e "$rel" ] && rel="$AIRY_HOME/releases/${new_id}-$(date +%H%M%S)"
    if ! mv "$extracted" "$rel"; then
        log error "版本目录就位失败（rename 被拒，检查磁盘/权限），当前版本未受影响"
        rm -rf "$TMPD"; upd_lock_rel; return 1
    fi
    rm -rf "$TMPD"
    upd_intent_set "$new_id"
    [ -d "$rel/bin" ] || mkdir -p "$rel/bin"
    if [ -d "$AIRY_HOME/bin" ]; then
        local _ef
        for _ef in airymaxrt airymaxrt-full agentrt-env.sh; do
            [ -e "$rel/bin/$_ef" ] && continue
            [ -f "$AIRY_HOME/bin/$_ef" ] && cp -f "$AIRY_HOME/bin/$_ef" "$rel/bin/$_ef" 2>/dev/null || true
        done
    fi
    if [ ! -x "$rel/bin/airy_cli" ] || [ ! -x "$rel/bin/agentrt-bootstrap.sh" ]; then
        log error "制品自检失败（bin/ 关键组件缺失），已中止更新，当前版本未受影响"
        rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
    fi
    local _py
    for _py in airymax_agents airymax_agents_rs orchestration agentrt; do
        if [ ! -d "$rel/lib/$_py" ]; then
            log error "制品自检失败（lib/${_py} python 运行时缺失），已中止更新，当前版本未受影响"
            rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
        fi
    done
    rel_env_write "$rel" "v${new_ver}" "$expect_sha"
    : > "$rel/.complete"
    local prev_rel=""
    prev_rel="$(readlink "$AIRY_HOME/current" 2>/dev/null || true)"
    if ! rel_commit "$rel"; then
        log error "更新提交失败（current 切换被拒），当前版本未受影响"
        rm -rf "$rel"; upd_intent_clear; upd_lock_rel; return 1
    fi
    upd_intent_clear
    log ok "新版本已提交: $new_id"
    if [ -d "$rel/config" ]; then
        mkdir -p "$AIRY_HOME/config"
        local f b
        for f in "$rel"/config/*; do
            [ -f "$f" ] || continue
            b="$(basename "$f")"
            case "$b" in
                secrets.env) continue ;;
                agentrt.yaml|model.yaml|permission_rules.yaml)
                    cp -f "$f" "$AIRY_HOME/config/$b" 2>/dev/null || true
                    log info "config 模板已随更新刷新: $b" ;;
                *) [ -f "$AIRY_HOME/config/$b" ] || cp -f "$f" "$AIRY_HOME/config/" 2>/dev/null || true ;;
            esac
        done
    fi
    if [ -f "$AIRY_HOME/config/permission_rules.yaml" ]; then
        mkdir -p "$AIRY_HOME/config/cupolas"
        cp -f "$AIRY_HOME/config/permission_rules.yaml" "$AIRY_HOME/config/cupolas/permission_rules.yaml" 2>/dev/null || true
        chmod 600 "$AIRY_HOME/config/cupolas/permission_rules.yaml" 2>/dev/null || true
    fi
    [ -f "$rel/keys/agentrt.asc" ] && cp -f "$rel/keys/agentrt.asc" "$AIRY_HOME/keys/" 2>/dev/null || true
    if [ -f "$AIRY_HOME/config/install.env" ]; then
        if grep -q '^AIRY_VERSION=' "$AIRY_HOME/config/install.env" 2>/dev/null; then
            sed_inplace "s|^AIRY_VERSION=.*|AIRY_VERSION=v${new_ver}|" "$AIRY_HOME/config/install.env"
        else
            printf 'AIRY_VERSION=v%s\n' "$new_ver" >> "$AIRY_HOME/config/install.env"
        fi
        if grep -q '^AIRY_ARTIFACT_SHA256=' "$AIRY_HOME/config/install.env" 2>/dev/null; then
            sed_inplace "s|^AIRY_ARTIFACT_SHA256=.*|AIRY_ARTIFACT_SHA256=${expect_sha}|" "$AIRY_HOME/config/install.env"
        else
            printf 'AIRY_ARTIFACT_SHA256=%s\n' "$expect_sha" >> "$AIRY_HOME/config/install.env"
        fi
        chmod 600 "$AIRY_HOME/config/install.env" 2>/dev/null || true
    fi
    if [ -f "$AIRY_HOME/bin/agentrt-env.sh" ] \
       && ! grep -q 'LD_LIBRARY_PATH' "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null; then
        printf '\nexport LD_LIBRARY_PATH="${AIRY_HOME}/lib:${LD_LIBRARY_PATH:-}"\n' \
            >> "$AIRY_HOME/bin/agentrt-env.sh"
        chmod 700 "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null || true
        log info "agentrt-env.sh 已补写 LD_LIBRARY_PATH 注入（0.1.6c 自愈）"
    fi
    local _entry="$AIRY_HOME/bin/airymaxrt"
    local _entry_resolved="$_entry"
    if [ -L "$_entry" ]; then
        _entry_resolved="$(readlink "$_entry" 2>/dev/null || echo "$_entry")"
    fi
    if [ -s "$_SOURCE" ] && [ "$_SOURCE" != "$_entry_resolved" ]; then
        if cp -f "$_SOURCE" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已重生成（no-args 将自动拉起守护进程群）"
        else
            log warn "入口启动器重生成失败（可运行 airymaxrt start 或重装修复）"
        fi
    elif [ ! -x "$_entry" ] && [ -n "$prev_rel" ] && [ -s "$prev_rel/bin/airymaxrt" ]; then
        if cp -f "$prev_rel/bin/airymaxrt" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已从上一版本恢复（自举源不可用）"
        else
            log warn "入口启动器恢复失败，请运行 install.sh --reinstall"
        fi
    fi
    rel_prune
    upd_lock_rel
    log ok "更新完成: v${new_ver}（重跑 airymaxrt 生效）"
    return 0
}

stop_running_daemons() {
    # B13 收摊归一：daemon 群生命周期归 supervisor_d，先走 shutdown；
    # pkill 循环仅兜底清理旧版（B13 前直拉起）残留实例
    local found=0 d n p exe
    if _sock_alive "$RUNTIME_DIR/supervisor.sock"; then
        if _sup_stop_wait; then
            found=1
            log info "supervisor 已收摊（daemon 群随之退出）"
        else
            log warn "supervisor 未能优雅退出，转兜底清理"
        fi
    fi
    for d in "$AIRY_HOME"/bin/*_d; do
        [ -f "$d" ] || continue
        d="${d##*/}"
        if [ -x "$AIRY_HOME/bin/$d" ]; then
            pkill -f "$AIRY_HOME/bin/$d" >/dev/null 2>&1 && found=1
            if [ -r /proc/self/exe ] && command -v pgrep >/dev/null 2>&1; then
                for p in $(pgrep -x "$d" 2>/dev/null); do
                    exe="$(readlink "/proc/$p/exe" 2>/dev/null)"
                    [ "${exe%% *}" = "$AIRY_HOME/bin/$d" ] || continue
                    kill "$p" 2>/dev/null && found=1
                done
            fi
        fi
    done
    if [ "$found" = "1" ]; then
        sleep 2
        log info "旧版本 daemon 已自动停止（下次启动加载新版本）"
    fi
}

airymaxrt_update() {
    local CHECK=0 CHANNEL="" CH_EXPLICIT=0 ROLLBACK=0 FILE="" SHA256="" inst_env="$AIRY_HOME/config/install.env"
    while [ $# -gt 0 ]; do
        case "$1" in
            --check|-c) CHECK=1 ;;
            --channel) CHANNEL="${2:-}"; CH_EXPLICIT=1; shift ;;
            --rollback) ROLLBACK=1 ;;
            --file|-f) FILE="${2:-}"; shift ;;
            --sha256) SHA256="${2:-}"; shift ;;
            --yes|-y) : ;;
            *) log error "未知参数: $1（--check/--channel/--rollback/--file/--sha256）"; return 2 ;;
        esac
        shift
    done
    local cur_ver="" cur_ch="stable" cur_sha=""
    if [ -f "$inst_env" ]; then
        cur_ver="$(sed -n 's/^AIRY_VERSION=//p' "$inst_env" | head -1)"
        cur_ch="$(sed -n 's/^AIRY_CHANNEL=//p' "$inst_env" | head -1)"
        cur_sha="$(sed -n 's/^AIRY_ARTIFACT_SHA256=//p' "$inst_env" | head -1)"
    fi
    CHANNEL="${CHANNEL:-${cur_ch:-stable}}"
    case "$CHANNEL" in stable|rc|beta) ;; *) log error "通道无效: ${CHANNEL}（stable|rc|beta）"; return 2 ;; esac
    if [ "$CH_EXPLICIT" = "0" ] && [ "$CHANNEL" != "stable" ]; then
        log info "通道 ${CHANNEL}（继承自安装记录 config/install.env）；切回生产线：airymaxrt update --channel stable"
    fi

    if [ "$ROLLBACK" = "1" ]; then
        migrate_layout || return 1
        upd_lock_acq || return 1
        upd_recover || { upd_lock_rel; return 1; }
        local rb="$(rel_prev)"
        [ -n "$rb" ] || { log error "无可用回滚目标（releases/ 仅含当前版本）"; upd_lock_rel; return 1; }
        local from_id="$(rel_cur_id)"
        log info "回滚到: $(basename "$rb")…"
        if ! rel_commit "$rb"; then
            log error "回滚失败（current 切换被拒），当前版本未受影响"
            upd_lock_rel; return 1
        fi
        upd_env_sync "$rb"
        upd_intent_clear
        stop_running_daemons
        # 回滚是终态动作：移除被放弃版本，防止再次回滚乒乓回切到已知损坏版本
        if [ -n "$from_id" ]; then
            rm -rf "${AIRY_HOME}/releases/$from_id" || log warn "被放弃版本目录移除失败（不影响回滚）: $from_id"
        fi
        upd_lock_rel
        log ok "回滚完成（重新运行 airymaxrt 生效）"
        return 0
    fi

    if [ -n "$FILE" ]; then
        [ -f "$FILE" ] || { log error "本地包不存在: $FILE"; return 1; }
        local expect_sha="$SHA256"
        if [ -z "$expect_sha" ] && [ -f "${FILE}.sha256" ]; then
            expect_sha="$(cut -d' ' -f1 "${FILE}.sha256" 2>/dev/null)"
        fi
        if [ -z "$expect_sha" ]; then
            log error "离线包必须提供校验值：--sha256 <hash> 或相邻 ${FILE}.sha256（防供应链绕过）"
            return 1
        fi
        log info "应用本地离线包: $(basename "$FILE")（sha256 强制校验）…"
        local f_rc=0
        apply_package "$FILE" "$expect_sha" || f_rc=$?
        [ "$f_rc" = "0" ] && stop_running_daemons
        return "$f_rc"
    fi

    local TMPD="$AIRY_HOME/tmp/update.$$"
    rm -rf "$TMPD"; mkdir -p "$TMPD"
    log info "检查更新（通道: ${CHANNEL}，当前: ${cur_ver:-<未安装>}）…"
    fetch_release_asset "manifest.${CHANNEL}.json" "$TMPD/manifest.json" \
        || {
            log error "manifest 拉取失败：${AIRY_RELEASE_BASE}/latest/manifest.${CHANNEL}.json"
            log error "可能是网络/服务异常；也可能该通道暂无制品——当前可用：stable（生产）/ rc（候选），beta 为保留通道"
            log error "切换通道：airymaxrt update --channel stable"
            rm -rf "$TMPD"; return 1
        }
    fetch_release_asset "manifest.${CHANNEL}.json.asc" "$TMPD/manifest.json.asc" >/dev/null 2>&1 || true
    verify_gpg_sig "$TMPD/manifest.json" "$TMPD/manifest.json.asc" || { log error "manifest 验签失败（GPG），拒绝更新"; rm -rf "$TMPD"; return 1; }
    log info "manifest 验签通过（GPG）"
    if [ "$(manifest_get "$TMPD/manifest.json" state)" = "reserved" ]; then
        log error "通道 ${CHANNEL} 为保留通道（state=reserved），官方尚未发布任何制品"
        log error "当前可用：stable（生产）/ rc（候选）"
        log error "切换通道：airymaxrt update --channel stable"
        rm -rf "$TMPD"; return 1
    fi
    local latest="$(manifest_get "$TMPD/manifest.json" latest)"
    [ -n "$latest" ] || { log error "manifest 解析失败"; rm -rf "$TMPD"; return 1; }
    local cmp="$(ver_cmp "${cur_ver:-0.0.0}" "$latest")"
    if [ "$cmp" = "1" ]; then
        log warn "通道 ${CHANNEL} 最新为 ${latest}，低于已安装的 ${cur_ver}（不回退）"
        if [ "$CHANNEL" != "stable" ]; then
            log warn "若想跟随生产版本线：airymaxrt update --channel stable"
        fi
        rm -rf "$TMPD"; return 0
    fi
    local plat="$(runtime_platform)"
    local art_url art_sha art_size=""
    art_url="$(manifest_field "$TMPD/manifest.json" "$plat" url)"
    art_sha="$(manifest_field "$TMPD/manifest.json" "$plat" sha256)"
    art_size="$(manifest_field "$TMPD/manifest.json" "$plat" size)"
    if [ -z "$art_url" ] && [ -z "$art_sha" ]; then
        for legacy in $(plat_legacy_name "$plat"); do
            [ -n "$legacy" ] || continue
            art_url="$(manifest_field "$TMPD/manifest.json" "$legacy" url)"
            art_sha="$(manifest_field "$TMPD/manifest.json" "$legacy" sha256)"
            art_size="$(manifest_field "$TMPD/manifest.json" "$legacy" size)"
            { [ -n "$art_url" ] || [ -n "$art_sha" ]; } && { log warn "平台键 ${plat} 未命中，已用兼容命名 ${legacy}"; break; }
        done
    fi
    if [ "$cmp" = "0" ]; then
        if [ -z "$art_sha" ] || [ "$art_sha" = "${cur_sha:-}" ]; then
            log info "已是最新: ${cur_ver:-<未安装>}（最新 ${latest}，发布面 manifest 为唯一事实源）"
            rm -rf "$TMPD"; return 0
        fi
        log info "同版本制品变更: ${cur_ver:-<未安装>}（sha256 与已装记录不同，按修复重发更新）"
    else
        log info "发现新版本: ${cur_ver:-<未安装>} → ${latest}（${CHANNEL}）"
    fi
    [ -n "$art_url" ] || {
        log error "当前平台 ${plat} 无可用制品"
        case "$plat" in
            *riscv*)
                log error "RISC-V（${plat}）暂无官方预编译制品（CI 仅 canary 构建）"
                log error "请在目标机源码构建：AIRY_MODE=source bash install.sh（需 RISC-V 工具链 + 依赖库）"
                ;;
        esac
        log error "若您安装的是旧版本（≤v0.1.6d），安装器已过旧无法自举更新；"
        log error "请重新执行一键安装命令（见官网 install 指南）更新安装器后重试。"
        rm -rf "$TMPD"; return 1
    }
    [ "$CHECK" = "1" ] && { log info "仅检查模式：更新可用"; rm -rf "$TMPD"; return 0; }
    local tarball="$TMPD/$(basename "${art_url%%\?*}")"
    local _dl_flags="-fsSL"
    [ -t 2 ] && _dl_flags="-fL --progress-bar"
    if [ -n "$art_size" ]; then
        log info "下载制品（$(human_size "$art_size")）: ${art_url}"
    else
        log info "下载制品: ${art_url}"
    fi
    syscurl $_dl_flags --max-time 600 -o "$tarball" "$art_url" || { log error "制品下载失败"; rm -rf "$TMPD"; return 1; }
    log ok "制品下载完成: $(human_size "$(wc -c < "$tarball" 2>/dev/null | tr -d ' ')")"
    apply_package "$tarball" "$art_sha"
    local rc=$?
    rm -rf "$TMPD"
    [ "$rc" = "0" ] && stop_running_daemons
    return $rc
}

ensure_installer() {
    local act="$1" inst="${AIRY_HOME}/scripts/install.sh"
    if [ -f "$inst" ]; then
        log debug "安装器就绪: $inst"
        printf '%s\n' "$inst"
        return 0
    fi
    log warn "${act}: 本机未找到安装器脚本 $inst"
    if [ -n "${AIRY_NO_NETWORK:-}" ] || ! command -v curl >/dev/null 2>&1; then
        log error "${act}: 无法在线拉取安装器（AIRY_NO_NETWORK 已设或 curl 不可用）"
        return 1
    fi
    local fetched="$AIRY_HOME/tmp/install.$$.sh"
    mkdir -p "$AIRY_HOME/tmp" 2>/dev/null || true
    if fetch_release_asset "install.sh" "$fetched"; then
        chmod 755 "$fetched"
        log warn "${act}: 本机安装器缺失，已从发布面附件在线拉取兜底: $fetched"
        printf '%s\n' "$fetched"
        return 0
    fi
    rm -f "$fetched"
    log error "${act}: 在线拉取安装器失败（请检查网络后重试）"
    return 1
}

FRONTEND_TUI=1
CLI_ARGS=()
CMD="${1:-}"
case "$CMD" in
    --help|-h|help)
        echo "用法: airymaxrt [airy_cli 参数]（默认进入 TUI 渲染层）"
        echo "      airymaxrt cli [airy_cli 参数]  行式模式（不经 TUI 渲染层）"
        echo "      airymaxrt profile [full|minimal|auto]  查看/切换运行画像（硬件自适应）"
        echo "      airymaxrt monitor   硬件监控：检测到能力增强自动恢复功能"
        echo "                        （monitor --daemon 后台常驻 / --stop 停止）"
        echo "      airymaxrt status      查看运行时状态"
        echo "      airymaxrt stop        收摊 daemon 群（supervisor.shutdown 唯一收摊入口）"
        echo "      airymaxrt doctor      组件健康检查"
        echo "      airymaxrt logs [N]    查看最近日志（默认 airymaxrt.log 末 50 行；"
        echo "                            logs <name> 看指定 daemon，如 logs llm_d）"
        echo "      airymaxrt update      自更新（--check 仅检查 / --channel stable|rc|beta"
        echo "                            切通道 / --rollback 回滚 / --file 离线包"
        echo "                            （离线包需 --sha256 或相邻 .sha256））"
        echo "      airymaxrt uninstall   一键卸载（--keep-data 保留记忆数据）"
        echo "      airymaxrt reinstall   强制重装（清缓存下载最新版 + 停旧 daemon）"
        exit 0
        ;;
    cli)
        if [ -z "$CLI_BIN" ]; then
            log error "airy_cli 未找到（CLI_BIN 为空）"
            exit 1
        fi
        FRONTEND_TUI=0
        shift
        CLI_ARGS=("$@")
        ;;
    stop)
        # B13 收摊归一唯一入口：supervisor.shutdown（daemon 群随之退出）
        if _sup_stop_wait; then
            log ok "运行时已收摊（daemon 群随 supervisor 退出）"
        else
            log warn "supervisor 超时未退出（可 'pkill supervisor_d' 兜底）"
            exit 1
        fi
        exit 0
        ;;
    -*)
        CLI_ARGS=("$@")
        ;;
    profile)
        case "${2:-}" in
            ""|status)
                if ! _HW="$(assess_hardware)"; then
                    log error "硬件探测失败，无法生成硬件快照"
                    exit 1
                fi
                _HW_P="${_HW%%|*}"
                _HW_REST="${_HW#*|}"
                _MEM_TOTAL="${_HW_REST%%|*}"
                _MEM_REST="${_HW_REST#*|}"
                _MEM_AVAIL="${_MEM_REST%%|*}"
                _CPU="${_MEM_REST#*|}"
                _CPU="${_CPU%%|*}"
                _ACCEL="${_HW_REST##*|}"
                log info "当前画像: ${AIRYRT_PROFILE:-auto}（硬件建议: ${_HW_P}）"
                log info "硬件快照: $(detect_arch) · 内存 ${_MEM_TOTAL}KiB/可用 ${_MEM_AVAIL}KiB · CPU ${_CPU} 核 · 加速器 ${_ACCEL}"
                exit 0
                ;;
            full|minimal|auto)
                if [ "$2" = "auto" ]; then
                    if ! _HW="$(assess_hardware)"; then
                        log error "硬件探测失败，无法自动评估画像"
                        exit 2
                    fi
                    log info "自动评估画像: ${_HW%%|*}"
                    write_profile_state auto
                    AIRYRT_PROFILE="auto"
                else
                    write_profile_state "$2"
                    AIRYRT_PROFILE="$2"
                fi
                if [ "$AIRYRT_PROFILE" = "full" ]; then
                    log info "full 画像：补齐能力 daemon…"
                    ensure_aux_daemons
                fi
                log info "画像已生效: ${AIRYRT_PROFILE}（下次启动持久生效）"
                exit 0
                ;;
            *)
                log error "无效画像 '$2'（支持 full|minimal|auto）"
                exit 2
                ;;
        esac
        ;;
    monitor)
        case "${2:-}" in
            --daemon|--background|-d)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ] && \
                   [ -n "$(cat "$_MON_PID_FILE" 2>/dev/null)" ] && \
                   kill -0 "$(cat "$_MON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    log warn "硬件监控已在后台运行（PID=$(cat "$_MON_PID_FILE" 2>/dev/null)）"
                    exit 0
                fi
                mkdir -p "$RUNTIME_DIR"
                nohup bash "$SCRIPT_DIR/airymaxrt" monitor \
                    >"$AIRY_HOME/logs/airymaxrt-monitor.log" 2>&1 &
                echo "$!" >"$_MON_PID_FILE"
                log info "硬件监控后台运行（PID=$!，日志 $AIRY_HOME/logs/airymaxrt-monitor.log）"
                exit 0
                ;;
            --stop)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ]; then
                    _MON_PID="$(cat "$_MON_PID_FILE" 2>/dev/null)"
                    if [ -n "$_MON_PID" ] && kill -0 "$_MON_PID" 2>/dev/null; then
                        kill "$_MON_PID" 2>/dev/null
                        log info "硬件监控已停止（PID=${_MON_PID}）"
                    else
                        log warn "硬件监控未在运行（陈旧 PID 文件）"
                    fi
                    rm -f "$_MON_PID_FILE"
                else
                    log warn "未找到后台监控 PID 文件（未在后台运行？）"
                fi
                exit 0
                ;;
        esac
        trap 'log info "硬件监控退出"; exit 0' INT TERM
        _INT="${AIRYRT_MONITOR_INTERVAL:-10}"
        _HINTED=""   # 已提示的画像值：差异持续时只提示一次，回归一致后重置
        log info "硬件监控启动（间隔 ${_INT}s，Ctrl+C 退出），当前画像: ${AIRYRT_PROFILE}"
        while true; do
            if ! _HW="$(assess_hardware)"; then
                log warn "硬件探测失败，本轮跳过重评估（下轮重试）"
                sleep "$_INT"
                continue
            fi
            _CUR="${_HW%%|*}"
            _SNAP="${_HW#*|}"
            _ACCEL_NOW="${_SNAP##*|}"
            _ACCEL_BASE="${AIRY_HW_ACCEL:-none}"
            if [ "$_ACCEL_NOW" != "$_ACCEL_BASE" ]; then
                log info "外设变化: 加速器 ${_ACCEL_BASE} → ${_ACCEL_NOW}"
                upsert_profile_var AIRY_HW_ACCEL "$_ACCEL_NOW"
                if [ "$_ACCEL_NOW" != "none" ]; then
                    log info "检测到加速器（${_ACCEL_NOW}），本地推理能力可用（可配置本地模型）"
                else
                    log warn "加速器已不可见，本地推理将不可用（远程 LLM 不受影响）"
                fi
            fi
            if [ "$_CUR" != "$AIRYRT_PROFILE" ]; then
                if [ "$_CUR" = "full" ]; then
                    if [ "$AIRYRT_PROFILE_RAW" != "auto" ]; then
                        if [ "$_HINTED" != "$_CUR" ]; then
                            log warn "检测到硬件能力增强（${_SNAP}），但画像为显式设置 ${AIRYRT_PROFILE}"
                            log warn "执行 'airymaxrt profile full' 可立即恢复全量功能"
                            _HINTED="$_CUR"
                        fi
                    else
                        log info "检测到硬件能力增强（${_SNAP}），自动恢复全量功能"
                        write_profile_state full
                        AIRYRT_PROFILE=full
                        ensure_aux_daemons
                        _HINTED=""
                    fi
                elif [ "$_HINTED" != "$_CUR" ]; then
                    log warn "检测到资源下降（${_SNAP}，建议 minimal），当前画像 ${AIRYRT_PROFILE}"
                    log warn "可执行 'airymaxrt profile minimal' 主动裁剪，或重启进入 minimal"
                    _HINTED="$_CUR"
                fi
            else
                _HINTED=""
            fi
            sleep "$_INT"
        done
        ;;
    status)
        log info "AIRY_HOME=$AIRY_HOME"
        log info "画像: ${AIRYRT_PROFILE:-auto} · 架构: $(detect_arch) · 加速器: $(detect_accel)"
        log info "组件: CLI=${CLI_BIN:-缺失} GATEWAY=${GATEWAY_BIN:-缺失} LLM=${LLM_BIN:-缺失}"
        if [ -f "$AIRY_HOME/config/install.env" ]; then
            _BP="$(sed -n 's/^AIRY_BIN_DIR_IN_PATH=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
            _BL="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
            _BL="${_BL:-$HOME/.local/bin/airymaxrt}"
            _BD="${_BL%/airymaxrt}"
            if [ "$_BP" = "no" ]; then
                log warn "PATH 引导: ${_BD} 不在 PATH 中——当前 shell 输入 airymaxrt 会报 command not found"
                log warn "  临时生效: export PATH=\"${_BD}:\$PATH\""
                _RC_S="$HOME/.bashrc"
                case "$(basename "${SHELL:-/bin/sh}")" in
                    zsh) _RC_S="$HOME/.zshrc" ;;
                    fish) _RC_S="$HOME/.config/fish/config.fish" ;;
                    sh|dash|ash) _RC_S="$HOME/.profile" ;;
                esac
                log warn "  永久生效: echo 'export PATH=\"${_BD}:\$PATH\"' >> \"${_RC_S}\" && source \"${_RC_S}\""
            else
                log info "PATH 引导: ${_BD} 已在 PATH 中（输入 airymaxrt 即可启动）"
            fi
        fi
        if wait_for_health "$GATEWAY_URL" 1; then
            log info "gateway: 在线（${GATEWAY_URL}）"
        else
            log warn "gateway: 离线"
        fi
        _core_ok=1
        for _c in llm think agent tool; do
            if ! _sock_alive "$RUNTIME_DIR/$_c.sock"; then
                log warn "$_c.sock: 未就绪"
                _core_ok=0
            fi
        done
        if [ "$_core_ok" = "1" ]; then
            log info "daemon 群: 核心链路（llm/think/agent/tool）全部就绪"
        else
            log warn "daemon 群: 核心链路未全部就绪（运行 airymaxrt 拉起，或查看 logs/ 诊断）"
        fi
        exit 0
        ;;
    doctor)
        miss=0
        for name in CLI_BIN GATEWAY_BIN LLM_BIN THINK_BIN; do
            eval "val=\${$name:-}"
            if [ -n "$val" ] && [ -x "$val" ]; then log info "$name: $val"; else log warn "$name: 缺失"; miss=1; fi
        done
        if [ -f "$AIRY_HOME/config/secrets.env" ]; then log info "secrets.env: 就绪"; else log warn "secrets.env: 缺失（LLM 不可用）"; miss=1; fi
        if [ -f "$AIRY_HOME/config/install.env" ]; then log info "install.env: 就绪"; else log warn "install.env: 缺失"; fi
        if command -v curl >/dev/null 2>&1; then log info "curl: 就绪"; else log warn "curl: 缺失"; miss=1; fi
        _BL_D="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
        _BL_D="${_BL_D:-$HOME/.local/bin/airymaxrt}"
        _BD_D="${_BL_D%/airymaxrt}"
        _PATH_FOUND=0
        _P_SEG="$PATH"
        while [ -n "$_P_SEG" ]; do
            _seg="${_P_SEG%%:*}"
            if [ "$_seg" = "$_BD_D" ]; then
                _PATH_FOUND=1
                break
            fi
            if [ "$_seg" = "$_P_SEG" ]; then _P_SEG=""; else _P_SEG="${_P_SEG#*:}"; fi
        done
        if [ "$_PATH_FOUND" = "1" ]; then
            log info "PATH: ${_BD_D} 在 PATH 中"
        else
            log warn "PATH: ${_BD_D} 不在 PATH 中——输入 airymaxrt 会报 command not found"
            _RC_D="$HOME/.bashrc"
            case "$(basename "${SHELL:-/bin/sh}")" in
                zsh) _RC_D="$HOME/.zshrc" ;;
                fish) _RC_D="$HOME/.config/fish/config.fish" ;;
                sh|dash|ash) _RC_D="$HOME/.profile" ;;
            esac
            log warn "  永久生效: echo 'export PATH=\"${_BD_D}:\$PATH\"' >> \"${_RC_D}\" && source \"${_RC_D}\""
            miss=1
        fi
        _LD_MISS=""
        if command -v ldd >/dev/null 2>&1; then
            for _b in "$AIRY_HOME"/bin/*_d "$AIRY_HOME"/bin/airy_cli "$AIRY_HOME"/bin/agentrt-tui; do
                [ -x "$_b" ] || continue
                _nf="$(ldd "$_b" 2>/dev/null | grep -F 'not found' || true)"
                if [ -n "$_nf" ]; then
                    _LD_MISS="$_LD_MISS
  $(basename "$_b"): $(echo "$_nf" | sed 's/.*=> not found/缺/' | tr '\n' '; ')"
                    miss=1
                fi
            done
            if [ -n "$_LD_MISS" ]; then
                log warn "运行库缺失（daemon 将无法启动）:$_LD_MISS"
                log warn "  修复: airymaxrt reinstall（干净重装，保留 config/data）"
            else
                log info "运行库: 全部可解析"
            fi
        else
            log info "运行库: 平台无 ldd，跳过动态库解析检查"
        fi
        if [ "$miss" = "0" ]; then log info "doctor: 全部就绪"; else log warn "doctor: 存在缺失项"; fi
        exit 0
        ;;
    logs)
        _arg="${2:-}"
        _n=50
        _file="$AIRY_HOME/logs/airymaxrt.log"
        case "$_arg" in
            "") ;;
            *[!0-9]*)
                if [ -f "$AIRY_HOME/logs/$_arg" ]; then
                    _file="$AIRY_HOME/logs/$_arg"
                elif [ -f "$AIRY_HOME/logs/${_arg}.out" ]; then
                    _file="$AIRY_HOME/logs/${_arg}.out"
                elif [ -f "$AIRY_HOME/logs/${_arg}.log" ]; then
                    _file="$AIRY_HOME/logs/${_arg}.log"
                else
                    log error "未找到日志: ${_arg}（可用: $(ls "$AIRY_HOME/logs" 2>/dev/null | tr '\n' ' ')）"
                    exit 1
                fi
                _n="${3:-50}"
                ;;
            *)
                _n="$_arg"
                ;;
        esac
        case "$_n" in
            *[!0-9]*|"") _n=50 ;;
        esac
        if [ ! -f "$_file" ]; then
            log error "日志文件不存在: $_file"
            exit 1
        fi
        echo "── ${_file}（末 ${_n} 行）────────────────────────────" >&2
        tail -n "$_n" "$_file"
        exit 0
        ;;
    uninstall)
        inst="$(ensure_installer uninstall)" || {
            log error "请重新执行官方一键安装命令（见官网 install 指南）后再卸载，"
            log error "或手动删除: $AIRY_HOME"
            exit 1
        }
        log info "委托安装器执行卸载: $inst"
        shift
        if [ "$AIRY_HOME" != "${HOME}/.airymaxrt" ]; then
            exec sh "$inst" --uninstall --prefix "$AIRY_HOME" "$@"
        fi
        exec sh "$inst" --uninstall "$@"
        ;;
    reinstall)
        inst="$(ensure_installer reinstall)" || {
            log error "请重新执行官方一键安装命令（见官网 install 指南）以完成重装"
            exit 1
        }
        log info "委托安装器执行重装: $inst"
        shift
        if [ "$AIRY_HOME" != "${HOME}/.airymaxrt" ]; then
            exec sh "$inst" --reinstall --prefix "$AIRY_HOME" "$@"
        fi
        exec sh "$inst" --reinstall "$@"
        ;;
    update)
        shift
        airymaxrt_update "$@" || { _u_rc=$?; exit "$_u_rc"; }
        exit 0
        ;;
esac

# 运行路径专属注入：管理命令（update 等）不 source 旧制品 env/secrets 脚本，
# 防止其损坏（含 exit 语句）时更新通道自锁。
# 外部脚本在宽松标志下 source（半写入截断脚本可致非零返回），
# 字面 exit 无法在 source 语义下拦截，由管理命令免注入保证自救通道。
safe_source() {
    set +e +u
    . "$1"
    local _rc=$?
    set -e -u
    return "$_rc"
}
_SECRET_FILE="$AIRY_HOME/config/secrets.env"
if [ -f "$_SECRET_FILE" ]; then
