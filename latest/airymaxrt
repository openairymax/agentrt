TUI_PID=""

cleanup() {
    # B13 集群服务化（§12.13）：daemon 群生命周期归 supervisor_d 持有，
    # 不随 TUI 会话退出收摊；收摊归一唯一入口为 'airymaxrt stop'
    if [ -n "$TUI_PID" ] && kill -0 "$TUI_PID" 2>/dev/null; then
        kill "$TUI_PID" 2>/dev/null || true
        wait "$TUI_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -z "$GATEWAY_BIN" ] && [ -z "$LLM_BIN" ]; then
    log warn "gateway_d 与 llm_d 均未找到，将以 OFFLINE 模式进入（对话功能不可用）。"
    log warn "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
else
    for _pf in "$RUNTIME_DIR"/*.pid; do
        [ -f "$_pf" ] || continue
        _p="$(cat "$_pf" 2>/dev/null)"
        if [ -z "$_p" ] || ! kill -0 "$_p" 2>/dev/null; then
            rm -f "$_pf"
            log debug "清理 stale pid 文件: $_pf"
        fi
    done
    _LOG_KEEP_DAYS="${AIRYRT_LOG_KEEP_DAYS:-7}"
    if command -v find >/dev/null 2>&1 && [ -d "$AIRY_HOME/logs" ]; then
        _CUTOFF=$(( $(date +%s) - _LOG_KEEP_DAYS * 86400 ))
        while IFS= read -r _old; do
            [ -n "$_old" ] || continue
            rm -f "$_old"
            log debug "清理过期运行时日志: $_old"
        done < <(find "$AIRY_HOME/logs" -maxdepth 1 -type f \
                     \( -name 'agent_*.log' -o -name '*.out' -o -name '*.pid' \) \
                     ! -newermt "@$_CUTOFF" -print 2>/dev/null)
    fi
    # B13 V13.4：daemon 群唯一拉起路径 = supervisor_d 声明驱动调谐；
    # 本脚本仅写入期望态声明并拉起 supervisor 本身（唯一 nohup 例外）
    SUPERV_SOCK="$RUNTIME_DIR/supervisor.sock"
    CORE_LIST=""
    REUSED_COUNT=0
    SUPERV_REUSE=0
    if _sock_alive "$SUPERV_SOCK"; then
        SUPERV_REUSE=1
        log info "supervisor 已在运行（复用 ${SUPERV_SOCK}），daemon 群由其接管"
    fi

    sup_stale_sock_rm() {
        # stale socket（无监听）清理：避免后续 spawn bind 失败
        [ -S "$1" ] || return 0
        _sock_alive "$1" && return 0
        log warn "检测到 stale socket（无监听），移除: $1"
        rm -f "$1"
    }
    sup_stale_sock_rm "$SUPERV_SOCK"

    core_decl() {
        # $1=名字 $2=bin $3=sock：在线复用剔除；二进制缺失告警不声明
        sup_stale_sock_rm "$3"
        if _sock_alive "$3"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "$1 已在运行（复用 $3）"
            return 0
        fi
        [ -z "$2" ] && return 1
        CORE_LIST="$CORE_LIST $1"
        return 0
    }
    core_decl llm_d "$LLM_BIN" "$RUNTIME_DIR/llm.sock" \
        || log warn "llm_d 未找到，模型接入不可用"
    core_decl think_d "$THINK_BIN" "$RUNTIME_DIR/think.sock" \
        || log warn "think_d 未找到，双思考（GCCP+GRAD）不可用，gateway 将降级直连"
    core_decl agent_d "$AGENT_BIN" "$RUNTIME_DIR/agent.sock" \
        || log warn "agent_d 未找到"
    core_decl tool_d "$TOOL_BIN" "$RUNTIME_DIR/tool.sock" \
        || log warn "tool_d 未找到"

    _gw_port_available() {
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import socket,sys; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(('127.0.0.1',int(sys.argv[1]))); s.close()" "$1" 2>/dev/null
        elif (echo >/dev/tcp/127.0.0.1/"$1") 2>/dev/null; then
            return 1
        elif command -v nc >/dev/null 2>&1; then
            if nc -z 127.0.0.1 "$1" >/dev/null 2>&1; then return 1; fi
            return 0
        else
            return 0
        fi
    }
    GW_REUSE="$GATEWAY_ALIVE"   # 复用判定：主端口健康或扫描到在线实例
    if [ "$GW_REUSE" = "1" ]; then
        log info "gateway 已在线（${GATEWAY_URL}），复用（生命周期归 supervisor/外部持有）"
    else
        for _p in "$GATEWAY_PORT" 8083 8084 8085 8086 8087 8088 8089 8090; do
            if _gw_port_available "$_p"; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log warn "端口 $GATEWAY_PORT 被占用（残留连接），gateway 改用端口 $_p"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                break
            fi
            if wait_for_health "http://127.0.0.1:$_p" 1; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log info "端口 $_p 已有在线 gateway，直接复用"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                GW_REUSE=1
                break
            fi
        done
    fi
    if [ "$GW_REUSE" = "1" ]; then
        REUSED_COUNT=$((REUSED_COUNT + 1))
        log info "gateway_d 已在运行（复用 ${GATEWAY_URL}）"
    elif [ -n "$GATEWAY_BIN" ]; then
        CORE_LIST="$CORE_LIST gateway_d"
        # gateway 运行参数经声明注入（supervisor spawn 时下发）
        upsert_profile_var AIRYRT_LAUNCH_ARGS_gateway_d "-h 127.0.0.1 -p $GATEWAY_PORT"
    else
        log warn "gateway_d 未找到，对话功能不可用（仅 CLI 降级可用）"
    fi
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    printf '%s\n' "$GATEWAY_PORT" > "$RUNTIME_DIR/gateway.port" 2>/dev/null || true

    # 期望态声明写入画像（supervisor 启动时只读装载）
    launch_decl_sync "$CORE_LIST"

    if [ "$SUPERV_REUSE" != "1" ]; then
        if [ -z "$SUPERVISOR_BIN" ]; then
            log error "supervisor_d 未找到，daemon 群无法拉起（B13 拉起唯一路径为 supervisor_d）"
            log error "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
            exit 1
        fi
        log debug "执行: nohup \"$SUPERVISOR_BIN\" > \"$AIRY_HOME/logs/supervisor_d.out\" 2>&1 &"
        nohup "$SUPERVISOR_BIN" >"$AIRY_HOME/logs/supervisor_d.out" 2>&1 &
        log info "supervisor_d 已拉起（PID=$!），日志: $AIRY_HOME/logs/supervisor_d.out"
        _sup_deadline=$((SECONDS + 10))
        until _sock_alive "$SUPERV_SOCK"; do
            if [ "$SECONDS" -ge "$_sup_deadline" ]; then
                log error "supervisor 控制口未就绪（${SUPERV_SOCK}），查看日志: $AIRY_HOME/logs/supervisor_d.out"
                exit 1
            fi
            sleep 0.25
        done
        log info "supervisor 控制口就绪（${SUPERV_SOCK}）"
    fi

    sup_wait_core() {
        # 声明调谐等待：CORE spawn 完成（gateway 无 unix sock，HTTP 健康另行等待）
        [ -z "$CORE_LIST" ] && return 0
        local deadline=$((SECONDS + 15)) n left
        while [ "$SECONDS" -lt "$deadline" ]; do
            left=0
            for n in $CORE_LIST; do
                [ "$n" = "gateway_d" ] && continue
                _sock_alive "$RUNTIME_DIR/${n%_d}.sock" || left=$((left + 1))
            done
            [ "$left" -eq 0 ] && return 0
            sleep 0.25
        done
        log warn "CORE daemon 未全部就绪（${left} 个待就绪）: ${CORE_LIST}"
        return 1
    }
    CORE_PENDING=0
    sup_wait_core || CORE_PENDING=1

    if [ "$AIRYRT_PROFILE" != "minimal" ]; then
        ensure_aux_daemons \
            || log warn "部分 aux daemon 激活失败（'airymaxrt doctor' 可复查）"
    fi

    if [ "$CORE_PENDING" = "0" ]; then
        if [ "$REUSED_COUNT" -gt 0 ]; then
            boot_line "守护进程群就绪（复用 ${REUSED_COUNT} 个 + 声明调谐完成）"
        else
            boot_line "守护进程群就绪（supervisor 声明调谐完成）"
        fi
    else
        diag_daemons
        boot_line "守护进程群部分未就绪，详见上方诊断"
    fi

    if wait_for_health "$GATEWAY_URL" 15; then
        log info "gateway 就绪（${GATEWAY_URL}）"
        boot_line "gateway 就绪（${GATEWAY_URL}）"
    else
        log warn "gateway 未能就绪（${GATEWAY_URL}），查看日志: $AIRY_HOME/logs/gateway_d.out"
        boot_line "gateway 未就绪（${GATEWAY_URL}），降级模式…"
        if [ -n "$CLI_BIN" ]; then
            log warn "降级：airy_cli 直连 daemon 群（不依赖 gateway）"
        else
            log error "交互界面依赖 gateway，但 airy_cli 缺失，无法降级"
            log error "可执行 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 下残留 socket 后重试"
            exit 1
        fi
    fi
fi

launch_frontend
rc=$?
log info "交互界面退出（exit=${rc}）"
exit $rc
