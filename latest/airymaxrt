log debug "组件定位结果: GATEWAY_BIN=${GATEWAY_BIN:-（缺失）}"
log debug "组件定位结果: LLM_BIN=${LLM_BIN:-（缺失）}"
log debug "组件定位结果: THINK_BIN=${THINK_BIN:-（缺失）}"
log debug "组件定位结果: SUPERVISOR_BIN=${SUPERVISOR_BIN:-（缺失）}"

wait_for_health() {
    local url="$1" tries="$2" i
    log debug "健康检查开始: ${url}（最多 ${tries}s）"
    for ((i = 0; i < tries; i++)); do
        if syscurl -fsS -m 1 -X POST -H 'Content-Type: application/json' \
            -d '{"jsonrpc":"2.0","method":"ping","id":1}' "$url" >/dev/null 2>&1; then
            log debug "健康检查通过: ${url}（第 $((i + 1)) 次尝试）"
            return 0
        fi
        log debug "健康检查未就绪: ${url}（第 $((i + 1)) 次尝试）"
        sleep 1
    done
    log debug "健康检查超时: $url"
    return 1
}

_sock_alive() {
    local path="$1"
    [ -S "$path" ] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(1.5); s.connect(sys.argv[1]); s.sendall(b'{\"jsonrpc\":\"2.0\",\"method\":\"health_check\",\"params\":{},\"id\":1}\n'); s.recv(1)" "$path" 2>/dev/null
    elif command -v nc >/dev/null 2>&1; then
        nc -zU "$path" 2>/dev/null
    elif command -v ss >/dev/null 2>&1; then
        ss -lx 2>/dev/null | grep -qF "$path" 2>/dev/null
    else
        return 1
    fi
}

ensure_aux_daemons() {
    # B13 V13.4：aux 按需激活唯一路径 = supervisor.activate 单向请求
    #（sock 预检：外部已在线实例不受监管，跳过避免 spawn 冲突）
    local d fail=0
    for d in $SUPERV_AUX_ALL; do
        _sock_alive "$RUNTIME_DIR/${d%_d}.sock" && continue
        if ! _sup_activate "$d"; then
            fail=$((fail + 1))
            log warn "$d 激活失败（supervisor 拒绝或控制口不可达）"
        fi
    done
    [ "$fail" -gt 0 ] && return 1
    return 0
}

write_profile_state() {
    # upsert 而非整文件覆盖：profile.env 同时承载 B13 launch 声明段
    upsert_profile_var AIRY_PROFILE "$1"
    log info "运行画像已持久化: ${PROFILE_ENV}（AIRY_PROFILE=$1）"
}

# ---- B13 supervisor 控制面（V13.4：daemon 拉起/收摊唯一路径） ----
_sup_activate() {
    # 退出码仅反映传输成败：未登记/spawn 失败须检查响应体 error 字段
    local r
    [ -x "${SUPERVISOR_BIN:-}" ] || return 1
    r="$("$SUPERVISOR_BIN" activate "$1" 2>/dev/null)" || return 1
    case "$r" in *'"error"'*) return 1 ;; esac
    return 0
}

_sup_stop_wait() {
    # 收摊归一：supervisor.shutdown + 宽限轮询（supervisor 退出自清 sock/pid）
    _sock_alive "$RUNTIME_DIR/supervisor.sock" || return 0
    if [ -x "${SUPERVISOR_BIN:-}" ]; then
        "$SUPERVISOR_BIN" stop >/dev/null 2>&1
    fi
    local deadline=$((SECONDS + 12))
    while [ "$SECONDS" -lt "$deadline" ]; do
        _sock_alive "$RUNTIME_DIR/supervisor.sock" || return 0
        sleep 0.5
    done
    return 1
}

# launch 声明写入画像（期望态 SSoT；supervisor 启动时只读装载）：
# CORE 由调用方传入（剔除已在线复用项），AUX 恒为全集（运行态由
# activate 决定），llm_d 运行参数经 ARGS 声明注入。
launch_decl_sync() {
    upsert_profile_var AIRYRT_LAUNCH_CORE "$1"
    upsert_profile_var AIRYRT_LAUNCH_AUX "$SUPERV_AUX_ALL"
    if [ -n "${LLM_BIN:-}" ] && [ -f "$MODEL_CONFIG" ]; then
        upsert_profile_var AIRYRT_LAUNCH_ARGS_llm_d "--manager $MODEL_CONFIG"
    fi
}

upsert_profile_var() {
    local key="$1" val="$2"
    mkdir -p "$AIRY_HOME/config"
    if grep -q "^${key}=" "$PROFILE_ENV" 2>/dev/null; then
        sed_inplace "s|^${key}=.*|${key}=${val}|" "$PROFILE_ENV"
    else
        printf '%s=%s\n' "$key" "$val" >>"$PROFILE_ENV"
    fi
    chmod 600 "$PROFILE_ENV" 2>/dev/null || true
}

