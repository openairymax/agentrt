wait_for_health() {
    local url="$1" tries="$2" i
    log debug "健康检查开始: ${url}（最多 ${tries}s）"
    for ((i = 0; i < tries; i++)); do
        if syscurl -fsS -m 1 -X POST -H 'Content-Type: application/json' \
            -d '{"jsonrpc":"2.0","method":"ping","id":1}' "$url" >/dev/null 2>&1; then
            log debug "健康检查通过: ${url}（第 $((i + 1)) 次尝试）"
            return 0
        fi
        log debug "健康检查未就绪: ${url}（第 $((i + 1)) 次尝试）"
        sleep 1
    done
    log debug "健康检查超时: $url"
    return 1
}

_sock_alive() {
    local path="$1"
    [ -S "$path" ] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(1.5); s.connect(sys.argv[1]); s.sendall(b'{\"jsonrpc\":\"2.0\",\"method\":\"health_check\",\"params\":{},\"id\":1}\n'); s.recv(1)" "$path" 2>/dev/null
    elif command -v nc >/dev/null 2>&1; then
        nc -zU "$path" 2>/dev/null
    elif command -v ss >/dev/null 2>&1; then
        ss -lx 2>/dev/null | grep -qF "$path" 2>/dev/null
    else
        return 1
    fi
}

# D5 模型端点健康：与 _sock_alive（只判连接性）互补——读 llm.sock 的
# health_check 全响应并解析 endpoints[]，回答"能力是否真的可用、代价多大"。
# 退出码：0 = 有端点且已打印；2 = 无匹配端点（未配置 local provider）；
# 1 = 探测不可用（llm.sock 不可达、响应不可解析，或 llm_d 侧探测视图降级）。
_ep_health() {
    local path="$1"
    [ -S "$path" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - "$path" <<'PY' 2>/dev/null
import json, socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(1.5)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
s.sendall(b'{"jsonrpc":"2.0","method":"health_check","params":{},"id":1}\n')
buf, resp = b"", None
for _ in range(16):
    try:
        chunk = s.recv(4096)
    except OSError:
        break
    if not chunk:
        break
    buf += chunk
    try:
        resp = json.loads(buf.decode("utf-8", "replace").strip())
        break
    except ValueError:
        continue
if resp is None:
    sys.exit(1)
result = resp.get("result") or {}
if result.get("endpoint_probe") is False:
    sys.exit(1)
eps = result.get("endpoints")
if not eps:
    sys.exit(2)
for ep in eps:
    line = "  - %s [%s] latency=%.0fms http=%s" % (
        ep.get("provider", "?"), ep.get("status", "unknown"),
        float(ep.get("latency_ms", 0) or 0), ep.get("http_code", 0))
    if ep.get("cold"):
        line += " cold(first_ms=%.0f model=%s)" % (
            float(ep.get("first_ms", 0) or 0), ep.get("cold_model", "-"))
    print(line)
PY
}

ensure_aux_daemons() {
    # B13 V13.4：aux 按需激活唯一路径 = supervisor.activate 单向请求
    #（sock 预检：外部已在线实例不受监管，跳过避免 spawn 冲突）
    local d fail=0
    for d in $SUPERV_AUX_ALL; do
        _sock_alive "$RUNTIME_DIR/${d%_d}.sock" && continue
        if ! _sup_activate "$d"; then
            fail=$((fail + 1))
            log warn "$d 激活失败（supervisor 拒绝或控制口不可达）"
        fi
    done
    [ "$fail" -gt 0 ] && return 1
    return 0
}

