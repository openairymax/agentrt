}

GATEWAY_ALIVE=0
if wait_for_health "$GATEWAY_URL" 1; then
    GATEWAY_ALIVE=1
    log info "gateway 在线（${GATEWAY_URL}），本次复用（不重复拉起）"
else
    log info "gateway 离线（${GATEWAY_URL}），将一并拉起"
