#!/usr/bin/env bash

set -euo pipefail

_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    case "$_SOURCE" in
        /*) ;;
        *) _SOURCE="$_DIR/$_SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
AIRYRT_HOME="${AIRYRT_HOME:-$(cd "$SCRIPT_DIR/../../.." && pwd)}"

# B2-6 自锚定快速路径：直接上级 install.env 单跳命中（开发态布局）；
# 版本化安装态（bin -> current/bin 物理化为 releases/<id>/）由下方祖先
# 循环兜底收敛，两层合力保证解析链永不退化为兜底根（防幽灵根）。
if [ -z "${AIRY_HOME:-}" ] && [ -f "${SCRIPT_DIR}/../config/install.env" ]; then
    AIRY_HOME="$(sed -n 's/^AIRY_HOME=//p' "${SCRIPT_DIR}/../config/install.env" 2>/dev/null | head -1)"
fi
if [ -z "${AIRY_HOME:-}" ]; then
    # 安装态 bin 为符号链接（bin -> current/bin），cd -P 后的物理父目录
    # 是 releases/<id>/，顶层 config/install.env 不在其直接上级——
    # 沿物理祖先逐级向上探测，仓库开发态与版本化安装态均收敛。
    _CAND="$SCRIPT_DIR"
    while [ -n "$_CAND" ] && [ "$_CAND" != "/" ]; do
        if [ -f "${_CAND}/config/install.env" ]; then
            AIRY_HOME="$(sed -n 's/^AIRY_HOME=//p' "${_CAND}/config/install.env" 2>/dev/null | head -1)"
            [ -n "$AIRY_HOME" ] && [ -d "$AIRY_HOME" ] && break
            AIRY_HOME=""
        fi
        _CAND="$(dirname "$_CAND")"
    done
fi
if [ -n "${AIRY_HOME:-}" ] && [ ! -d "${AIRY_HOME}" ]; then
    printf '\033[1;33m[WARN]\033[0m AIRY_HOME=%s 不存在（疑似终端残留环境变量），已忽略并回退统一路径\n' "$AIRY_HOME" >&2
    AIRY_HOME=""
fi
AIRY_HOME="${AIRY_HOME:-$HOME/.airymaxrt}"
export AIRY_HOME
# §12.12 唯一事实源：安装/更新面只读 release 附件（releases/download），
# 禁止经由仓库 API 直读分支文件作为第二事实源。
AIRY_RELEASE_OWNER="${AIRY_RELEASE_OWNER:-openairymax/agentrt}"
AIRY_RELEASE_BASE="${AIRY_RELEASE_BASE:-https://atomgit.com/${AIRY_RELEASE_OWNER}/releases/download}"
RUNTIME_DIR="${AIRY_HOME}/run"
GATEWAY_PORT="${AIRY_GATEWAY_PORT:-8080}"
GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"

if [ -f "${AIRY_MODEL_CONFIG:-$AIRY_HOME/config/model.yaml}" ]; then
    MODEL_CONFIG="${AIRY_MODEL_CONFIG:-$AIRY_HOME/config/model.yaml}"
else
    MODEL_CONFIG="${AIRY_MODEL_CONFIG:-$AIRYRT_HOME/ecosystem/manager/model/model.yaml}"
fi
AGENT_FILE="${AIRY_AGENT_FILE:-agents/main.agent.yaml}"

LOG_FILE="$AIRY_HOME/logs/airymaxrt.log"
AIRYRT_LOG_LEVEL="${AIRYRT_LOG_LEVEL:-info}"
mkdir -p "$AIRY_HOME/logs" "$RUNTIME_DIR"
touch "$LOG_FILE" 2>/dev/null || true

_log_num() {
    case "$1" in
        debug) echo 0 ;;
        info)  echo 1 ;;
        warn)  echo 2 ;;
        error) echo 3 ;;
        *)     echo 1 ;;
    esac
}
LOG_LEVEL_NUM="$(_log_num "$AIRYRT_LOG_LEVEL")"

log() {
    local lvl="$1"
    shift
    [ "$(_log_num "$lvl")" -ge "$LOG_LEVEL_NUM" ] || return 0
    local line
    line="[$(date '+%Y-%m-%d %H:%M:%S')] [$(printf '%s' "$lvl" | tr '[:lower:]' '[:upper:]')] $*"
    if [ "${AIRYRT_TERM_LOG:-}" != "quiet" ] || [ "$lvl" != "info" ]; then
        case "$lvl" in
            info)  printf '\033[1;36m%s\033[0m\n' "$line" >&2 ;;
            warn)  printf '\033[1;33m%s\033[0m\n' "$line" >&2 ;;
            error) printf '\033[1;31m%s\033[0m\n' "$line" >&2 ;;
        esac
    fi
    printf '%s\n' "$line" >>"$LOG_FILE"
}

path_rc_file() {
    case "$(basename "${SHELL:-/bin/sh}")" in
        zsh) echo "$HOME/.zshrc" ;;
        fish) echo "$HOME/.config/fish/config.fish" ;;
        sh|dash|ash) echo "$HOME/.profile" ;;
        *) echo "$HOME/.bashrc" ;;
    esac
}
path_self_heal() {
    [ -f "$AIRY_HOME/config/install.env" ] || return 0
    local _binl _bind
    _binl="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    _binl="${_binl:-$HOME/.local/bin/airymaxrt}"
    _bind="${_binl%/airymaxrt}"
    local _in_path=0 _p _seg
    _p="$PATH"
    while [ -n "$_p" ]; do
        _seg="${_p%%:*}"
        if [ "$_seg" = "$_bind" ]; then _in_path=1; break; fi
        if [ "$_seg" = "$_p" ]; then _p=""; else _p="${_p#*:}"; fi
    done
    [ "$_in_path" = "1" ] && return 0
    local _rc _line
    _rc="$(path_rc_file)"
    if grep -q '# >>> AgentRT PATH bootstrap <<<' "$_rc" 2>/dev/null; then
        log debug "PATH 自愈: $_rc 已含引导行，跳过"
        return 0
    fi
    if [ "$(basename "$_rc")" = "config.fish" ]; then
        _line="set -gx PATH \"${_bind}\" \$PATH"
    else
        _line="export PATH=\"${_bind}:\$PATH\""
    fi
    if printf '\n# >>> AgentRT PATH bootstrap <<<\n%s\n# <<< AgentRT PATH bootstrap <<<\n' "$_line" >> "$_rc" 2>/dev/null; then
        log warn "PATH 自愈: 已自动将 ${_bind} 追加到 ${_rc}（新开终端生效，或 source \"$_rc\"）"
    else
        log warn "PATH 自愈: 无法写入 ${_rc}——手动执行: echo '${_line}' >> \"$_rc\" && source \"$_rc\""
    fi
}

_uspace_bits() {
    local _b
    _b="$(getconf LONG_BIT 2>/dev/null)"
    case "$_b" in 32|64) echo "$_b"; return ;; esac
    if [ -r /proc/self/exe ] && command -v od >/dev/null 2>&1; then
        _b="$(od -An -j4 -N1 -t x1 /proc/self/exe 2>/dev/null | tr -d ' \n')"
        case "$_b" in 01) echo 32; return ;; 02) echo 64; return ;; esac
    fi
    if command -v dpkg >/dev/null 2>&1; then
        _b="$(dpkg --print-architecture 2>/dev/null)"
        case "$_b" in
            amd64|arm64|riscv64) echo 64; return ;;
            armhf|armel|i386)    echo 32; return ;;
        esac
    fi
    echo ""
}
_loader_exists() {
    local _n="$1" _p
    for _p in "/lib/$_n" "/lib64/$_n" "/usr/lib/$_n" \
              /lib/*-linux-gnu*/"$_n" /usr/lib/*-linux-gnu*/"$_n"; do
        [ -f "$_p" ] && return 0
    done
    return 1
}
_arch_warn_unknown() {
    log warn "架构判定: 用户空间位宽未知（getconf/ELF/dpkg 均不可用），按 $1 处理"
}
detect_arch() {
    local _m _bits
    _m="$(uname -m 2>/dev/null)"
    _bits="$(_uspace_bits)"
    case "$_m" in
        x86_64|amd64)
            if [ "$_bits" = "32" ]; then
                echo "i686"
            elif [ "$_bits" = "64" ] || _loader_exists ld-linux-x86-64.so.2; then
                echo "x86_64"
            elif _loader_exists ld-linux.so.2; then
                echo "i686"
            else
                _arch_warn_unknown "$_m"
                echo "i686"
            fi
            ;;
        i386|i486|i586|i686|x86) echo "i686" ;;
        aarch64|arm64)
            if [ "$_bits" = "32" ]; then
                echo "armv7l"
            elif [ "$_bits" = "64" ] || _loader_exists ld-linux-aarch64.so.1; then
                echo "aarch64"
            elif _loader_exists ld-linux-armhf.so.3; then
                echo "armv7l"
            else
                _arch_warn_unknown "$_m"
                echo "aarch64"
            fi
            ;;
        armv7l|armv6l|armhf) echo "armv7l" ;;
        riscv64)
            if [ "$_bits" = "32" ]; then
                echo "riscv32"
            elif [ "$_bits" = "64" ] || _loader_exists ld-linux-riscv64-lp64d.so.1; then
                echo "riscv64"
            else
                _arch_warn_unknown "$_m"
                echo "riscv32"
            fi
            ;;
        riscv32|riscv) echo "riscv32" ;;
        *)                echo "unknown" ;;
    esac
}
detect_accel() {
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        echo "nvidia:$(nvidia-smi -L 2>/dev/null | wc -l)"
    elif command -v rocm-smi >/dev/null 2>&1; then
        echo "rocm"
    elif [ -d /dev/dri ] && ls /dev/dri/renderD* >/dev/null 2>&1; then
        echo "dri"
    else
        echo "none"
    fi
}

assess_hardware() {
    local mem_kib="" mem_avail_kib="" nproc_val="" accel profile raw
    if [ -r /proc/meminfo ]; then
        mem_kib="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || true)"
        mem_avail_kib="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null || true)"
    elif command -v sysctl >/dev/null 2>&1; then
        raw="$(sysctl -n hw.memsize 2>/dev/null || true)"
        case "${raw:-0}" in ''|*[!0-9]*) raw=0 ;; esac
        mem_kib=$((raw / 1024))
        mem_avail_kib="$mem_kib"
    fi
    case "${mem_kib:-}" in ''|*[!0-9]*) mem_kib="" ;; esac
    case "${mem_avail_kib:-}" in ''|*[!0-9]*) mem_avail_kib="$mem_kib" ;; esac
    if command -v nproc >/dev/null 2>&1; then
        nproc_val="$(nproc 2>/dev/null || true)"
    elif command -v sysctl >/dev/null 2>&1; then
        nproc_val="$(sysctl -n hw.ncpu 2>/dev/null || true)"
    fi
    case "${nproc_val:-}" in ''|*[!0-9]*) nproc_val="" ;; esac
    if [ -z "$mem_kib" ] || [ "$mem_kib" -eq 0 ] || [ -z "$nproc_val" ]; then
        printf 'assess_hardware: 硬件探测失败（内存/核数不可得），拒绝静默降级为 minimal\n' >&2
        return 1
    fi
    accel="$(detect_accel)"
    if [ "$mem_kib" -ge $((2560 * 1024)) ] && \
       [ "$mem_avail_kib" -ge $((1536 * 1024)) ] && \
       [ "$nproc_val" -ge 3 ]; then
        profile="full"
    else
        profile="minimal"
    fi
    printf '%s|%s|%s|%s|%s' "$profile" "$mem_kib" "${mem_avail_kib:-0}" "$nproc_val" "$accel"
}

# profile.env 为声明式数据（KEY=VALUE，值可含空格），消费侧按数据逐行解析，
# 绝不 source：空格值会被 shell 逐词求值致第二个词当命令执行（§3.5 缺陷1）。
profile_load() {
    local _line _key _val
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in ''|'#'*) continue ;; esac
        case "$_line" in *=*) ;; *) continue ;; esac
        _key="${_line%%=*}"
        _val="${_line#*=}"
        case "$_key" in ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;; esac
        case "$_val" in
            \"*\") _val="${_val#\"}"; _val="${_val%\"}" ;;
            \'*\') _val="${_val#\'}"; _val="${_val%\'}" ;;
        esac
        export "$_key=$_val"
    done <"$PROFILE_ENV"
}

PROFILE_ENV="$AIRY_HOME/config/profile.env"
if [ -f "$PROFILE_ENV" ]; then
    profile_load
fi

AIRYRT_PROFILE_RAW="${AIRYRT_PROFILE:-${AIRY_PROFILE:-auto}}"
AIRYRT_PROFILE="$AIRYRT_PROFILE_RAW"
case "$AIRYRT_PROFILE" in
    full|minimal|auto) ;;
    *) log error "无效的 AIRYRT_PROFILE='$AIRYRT_PROFILE'（支持 full|minimal|auto）"
       exit 2 ;;
esac
if [ "$AIRYRT_PROFILE" = "auto" ]; then
    if ! _HW_ASSESS="$(assess_hardware)"; then
        log error "硬件探测失败，无法自动评估画像；请显式设置 AIRYRT_PROFILE=full|minimal 后重试"
        exit 2
    fi
    AIRYRT_PROFILE="${_HW_ASSESS%%|*}"
    log info "硬件评估: 内存 ${_HW_ASSESS#*|}"
    log info "自动画像: $AIRYRT_PROFILE"
fi
log debug "AIRYRT_PROFILE=$AIRYRT_PROFILE"


boot_line() {
    printf '\033[2m›\033[0m %s\n' "$*" >&2
}

diag_daemons() {
    # 诊断声明 CORE 中未就绪者（supervisor spawn 失败或仍在退避）
    local n left="" _lines
    for n in ${CORE_LIST:-}; do
        [ "$n" = "gateway_d" ] && continue
        _sock_alive "$RUNTIME_DIR/${n%_d}.sock" && continue
        left="${left:+$left }$n"
    done
    [ -n "$left" ] || return 0
    log error "关键 daemon 未就绪: ${left}（对话/认知/执行链路必需）"
    for n in $left; do
        _lines="$(tail -n 3 "$AIRY_HOME/logs/${n}.out" 2>/dev/null | grep -v 'nohup: ignoring input' | tr '\n' ' ' | sed 's/  */ /g')" || true
        [ -n "$_lines" ] && log error "  ${n}: ${_lines}"
    done
    log error "处理: 'airymaxrt doctor' 检查组件，或 'airymaxrt stop' 收摊后重试"
}

log debug "==== airymaxrt 启动 ===="
log debug "配置: AIRYRT_HOME=$AIRYRT_HOME AIRY_HOME=$AIRY_HOME RUNTIME_DIR=$RUNTIME_DIR"
log debug "配置: GATEWAY_URL=$GATEWAY_URL MODEL_CONFIG=$MODEL_CONFIG AGENT_FILE=$AGENT_FILE"

case ":${LD_LIBRARY_PATH:-}:" in
    *":$AIRY_HOME/lib:"*) ;;
    *) export LD_LIBRARY_PATH="$AIRY_HOME/lib:${LD_LIBRARY_PATH:-}" ;;
esac

syscurl() {
    local ldp="" p
    local IFS=:
    for p in ${LD_LIBRARY_PATH:-}; do
        [ "$p" = "$AIRY_HOME/lib" ] && continue
        ldp="${ldp:+$ldp:}$p"
    done
    if [ -n "$ldp" ]; then
        env LD_LIBRARY_PATH="$ldp" curl "$@"
    else
        env -u LD_LIBRARY_PATH curl "$@"
    fi
}

sed_inplace() {
    local _se="$1" _f="$2" _t="${2}.tmp.$$"
    if sed "$_se" "$_f" > "$_t" 2>/dev/null; then
        mv "$_t" "$_f"
    else
        rm -f "$_t"
        return 1
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
    else
        printf ''
    fi
}

find_tool() {
    local env_name="$1" cmd_name="$2"
    shift 2
    if [ -n "${!env_name:-}" ]; then
        log debug "$env_name 环境变量覆盖: ${!env_name}"
        if [ -x "${!env_name}" ]; then
            echo "${!env_name}"
            return
        fi
        log warn "$env_name 指向的路径不可执行: ${!env_name}"
    fi
    local c
    for c in "$@"; do
        if [ -x "$c" ]; then
            log debug "找到 $cmd_name: $c"
            echo "$c"
            return
        fi
        log debug "候选不存在: $c"
    done
    local from_path
    if from_path="$(command -v "$cmd_name" 2>/dev/null)"; then
        log debug "PATH 中找到 $cmd_name: $from_path"
        echo "$from_path"
    else
        log warn "未找到 ${cmd_name}（PATH 与候选路径均无）"
    fi
}

CLI_BIN="$(find_tool AIRY_CLI_BIN airy_cli \
