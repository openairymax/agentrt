# B13 V13.4：supervisor 声明调谐的 AUX 全集（与 decl.c 内置缺省一致；
# 0.1.19 R7 并户后 hook 面由 notify_d 承载）
SUPERV_AUX_ALL="monit_d sched_d channel_d market_d cupolas_d mem_d a2a_d notify_d"

sup_bin_link() {
    # supervisor 仅认 $AIRY_HOME/bin/<name>（launch 声明只记名字）：
    # 开发态构建产物以符号链接归位，安装态真实文件不受影响
    local bin="$1" dst
    [ -x "$bin" ] || return 0
    dst="$AIRY_HOME/bin/${bin##*/}"
    [ -e "$dst" ] && [ ! -L "$dst" ] && return 0
    [ "$(readlink "$dst" 2>/dev/null)" = "$bin" ] && return 0
    mkdir -p "$AIRY_HOME/bin" 2>/dev/null || true
    ln -sfn "$bin" "$dst" 2>/dev/null || true
}

sup_bin_link "$SUPERVISOR_BIN"
