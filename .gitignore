# ===========================================================================
# AgentRT 管理仓 .gitignore
# 策略：非必要不追踪。各叶子仓自行维护 .gitignore
# ---------------------------------------------------------------------------
# 默认忽略所有
# ---------------------------------------------------------------------------
*
# ---------------------------------------------------------------------------
# 管理仓必要文件（白名单）
# ---------------------------------------------------------------------------
!.clang-format
!.clang-format-ignore
!.gitignore
!.gitmodules
!.gitattributes
!.github/
!.github/**
!ACKNOWLEDGMENTS.md
!CHANGELOG.md
# RELEASE_NOTES.d/：维护者本地发布素材目录，不入库、不随仓分发
!CMakeLists.txt
!CONTRIBUTING.md
!Doxyfile
!LICENSE
!NOTICE
!README.md
!README_zh.md
!SECURITY.md
!SUPPORT.md
!tests/
!tests/CMakeLists.txt
!tests/test_banned_functions.c
!tests/test_smoke.c
!tests/test_string_utils.c
!tests/test_utils.c
!tests/e2e/
!tests/e2e/**
!LICENSES/
!LICENSES/**
# M1-1b 模块链接白名单单一权威（airy_depgraph --links 构建期门禁消费）
!link-whitelist.txt
# ---------------------------------------------------------------------------
# 管理仓必要工具（CMake/README/CHANGELOG 正式引用，须入库）：
# - tools/codegen: syscall.xml SSoT codegen 生成器（CMake 构建与 CI 防漂移校验依赖）
# - tools/airy_cli: 交互式产品 CLI（BUILD_CLI 默认 ON，产品层交互策略）
# ---------------------------------------------------------------------------
!tools/
!tools/codegen/
!tools/codegen/**
# Python 字节码缓存不追踪（daemon_gen.py 等生成器运行副产物）
tools/codegen/__pycache__/
!tools/airy_cli/
!tools/airy_cli/**
# ---------------------------------------------------------------------------
# 管理仓直属设施（IRON-9 [IND] 独立层，随仓入库）：
# - cmake/: 构建系统模块（compilerflags/platform/dependencies/sanitizers/utils 等）
# - scripts/: 官方安装器 install.sh/install.ps1
# ---------------------------------------------------------------------------
!cmake/
!cmake/**
!scripts/
!scripts/**
# ---------------------------------------------------------------------------
# packaging/: B12（0.1.18）npm 薄壳通道包（@openairymax/agentrt，N-1~N-5）。
# 发布链 publish-npm job 经 checkout 消费，必须入库；包内零安装逻辑，
# 唯一网络目标 = atomgit release 附件面（门禁扫描断言）。
# ---------------------------------------------------------------------------
!packaging/
!packaging/**
!VERSION
!latest/
!latest/**
# ---------------------------------------------------------------------------
# 叶子仓根放行：gitlink 已入库，此处仅解除忽略以免仓库级检索跳过整棵子树
# ---------------------------------------------------------------------------
!atoms/
!atoms/**
!commons/
!commons/**
!daemons/
!daemons/**
!gateway/
!gateway/**
!heapstore/
!heapstore/**
!protocols/
!protocols/**
